                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/negro_principal" />

            <TextView
                android:id="@+id/txtMesActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Septiembre 2026"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnMesSiguiente"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icono_circular"
                android:contentDescription="Mes siguiente"
                android:padding="9dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/negro_principal" />

        </LinearLayout>


