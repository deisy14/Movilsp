<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRedactarAvisoJefa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.RedactarAvisoJefaActivity">

    <!-- ENCABEZADO CON BOTÓN VOLVER Y TÍTULO DE LA JEFA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1B3317" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENVIAR AVISO AL ADMINISTRADOR"
                android:textColor="#1B3317"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtituloAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Notificación e informe sobre insumos del inventario PAE"
                android:textColor="#3D5C37"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO CON SCROLL SIN BARRA INFERIOR -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/contenedorFormularioAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>