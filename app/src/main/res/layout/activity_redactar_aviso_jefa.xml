<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRedactarAvisoJefa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.RedactarAvisoJefaActivity">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1B3317" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENVIAR AVISO AL ADMINISTRADOR"
                android:textColor="#1B3317"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Notificación e informe sobre insumos del inventario PAE"
                android:textColor="#3D5C37"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <!-- TARJETA PRINCIPAL CON BORDE AMARILLO ACENTUADO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeColor="#F4B41F"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enviar aviso al administrador"
                    android:textColor="#1B3317"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp"
                    android:text="Describe una novedad o faltante de tu bodega o cocina. Puedes adjuntar una fotografía."
                    android:textColor="#334155"
                    android:textSize="13sp" />

                <!-- Título del aviso -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título del aviso"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtTituloAviso"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input"
                    android:hint="Ej. Falta de insumos o stock"
                    android:inputType="textCapSentences"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#1E293B"
                    android:textSize="14sp" />

                <!-- Descripción -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtMensajeAviso"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_input"
                    android:gravity="top|start"
                    android:hint="Escribe aquí la novedad o detalle del insumo..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="14dp"
                    android:textColor="#1E293B"
                    android:textSize="14sp" />

                <!-- Imagen seleccionada text y vista previa -->
                <TextView
                    android:id="@+id/txtEstadoImagen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="No has seleccionado ninguna imagen."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/imgVistaPreviaAviso"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Vista previa"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Botón seleccionar foto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeleccionarFoto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:text="Seleccionar fotografía"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

                <!-- Botón quitar foto -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuitarFoto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="14dp"
                    android:text="Quitar fotografía"
                    android:textAllCaps="false"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    app:backgroundTint="#FEF2F2"
                    app:cornerRadius="12dp"
                    app:strokeColor="#FCA5A5"
                    app:strokeWidth="1dp" />

                <!-- Botón enviar aviso -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviarAviso"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#F4B41F"
                    android:text="Enviar aviso al Administrador"
                    android:textAllCaps="false"
                    android:textColor="#1B3317"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>