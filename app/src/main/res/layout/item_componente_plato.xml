<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_fila_lista"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgComponente"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Icono componente"
        android:scaleType="centerInside"
        android:src="@drawable/ic_leche" />

    <TextView
        android:id="@+id/tvNombreComponente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="Nombre componente"
        android:textColor="#34443A"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvTipoComponente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Proteína"
        android:textColor="#176B35"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
