<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="235dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8F5D8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgPlatoDisponible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Plato PAE"
                android:scaleType="centerCrop"
                android:src="@drawable/plato1" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtNombrePlatoDisponible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Pollo Guisado"
            android:textColor="#1B3520"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDisponibilidadIngredientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ingredientes disponibles"
            android:textColor="#2E7D32"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSeleccionarMenuDisponible"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_yellow"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Seleccionar plato"
            android:textColor="#1B3317"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>