<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:strokeColor="#FFC107"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- ENCABEZADO CON BOTÓN CERRAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SIRAE • Receta del Componente"
                android:textColor="#176B35"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCerrarModalComponente"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar ventana"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#65736A" />

        </LinearLayout>

        <!-- AVATAR / ICONO DEL COMPONENTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:background="@drawable/circulo_amarillo"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/imgComponenteModal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Imagen del componente"
                    android:scaleType="centerInside"
                    android:src="@drawable/apanado" />

            </FrameLayout>

            <!-- NOMBRE DEL COMPONENTE -->
            <TextView
                android:id="@+id/tvTituloComponenteModal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Nombre Componente"
                android:textColor="#173F2A"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- BADGE DE CLASIFICACIÓN (PROTEÍNA, PRINCIPIO, ETC.) -->
            <TextView
                android:id="@+id/tvBadgeTipoModal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_asignado"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:text="Proteína"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- DETALLE DE LA RECETA DEL COMPONENTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_fila_lista"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥗 Detalle de Receta / Insumos"
                android:textColor="#173F2A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="#EDEDED" />

            <!-- FILA: PLATO ASOCIADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Plato:"
                    android:textColor="#65736A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPlatoPerteneciente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arroz con Pollo"
                    android:textColor="#1D2939"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FILA: INGREDIENTES / INSUMOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Insumos base:"
                    android:textColor="#65736A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvIngredientesComponente"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:gravity="end"
                    android:text="Presa fresca, condimento y sal"
                    android:textColor="#176B35"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FILA: GRAMAJE / PORCIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Porción estimada:"
                    android:textColor="#65736A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPorcionComponente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80g - 100g por ración"
                    android:textColor="#1D2939"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- BOTÓN VER PASOS DE PREPARACIÓN -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerPasosModal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFD928"
            android:text="Ver pasos de preparación  ›"
            android:textAllCaps="false"
            android:textColor="#173F2A"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="15dp" />

        <!-- BOTÓN VER LISTA DE INGREDIENTES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerIngredientesModal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Ver lista de ingredientes  ›"
            android:textAllCaps="false"
            android:textColor="#176B35"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="15dp"
            app:strokeColor="#176B35"
            app:strokeWidth="1.5dp" />

        <!-- BOTÓN CERRAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarRecetaModal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="Cerrar"
            android:textAllCaps="false"
            android:textColor="#65736A"
            android:textSize="13sp"
            app:cornerRadius="15dp"
            app:strokeColor="#D0D5DD"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
