<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="100dp">

            <!-- BARRA SUPERIOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:clickable="true"
                    android:contentDescription="Volver"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#1B3317" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SIRAE PAE"
                    android:textColor="#1B3317"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="32dp" />

            </LinearLayout>

            <!-- TITULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Proceso de Preparación"
                android:textColor="#1B3317"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sigue las pautas e instrucciones de cocción e inocuidad escolar"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- CARD DESTACADA: PLATO + TURNO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgPlatoPreparacion"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Imagen del plato"
                            android:scaleType="centerCrop"
                            android:src="@drawable/pollo_guisado" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvNombrePlatoPreparacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Pollo Guisado Criollo"
                        android:textColor="#1B3317"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badgeTurnoPreparacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Estado:Por hacer"
                        android:textColor="#7A5500"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PASO A PASO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Paso a Paso de Cocción"
                android:textColor="#1B3317"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorPasos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- BANNER NORMAS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#EEF4DF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#C5DFC3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="Seguridad"
                        android:src="@drawable/ic_shield"
                        app:tint="#2A5226" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Asegúrate de verificar temperatura interna (>75°C) y cumplir normas BPM."
                        android:textColor="#1B3317"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN MARCAR PREPARADO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarcarPreparado"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F4B41F"
                android:text="Actualizar Estado de Preparación"
                android:textColor="#1B3317"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

    <!-- BARRA INFERIOR FIJA -->
    <include
        android:id="@+id/barra_navegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>