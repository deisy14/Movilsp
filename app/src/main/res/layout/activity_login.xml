<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181D24"
    android:fillViewport="true"
    android:fitsSystemWindows="false"
    android:forceDarkAllowed="false"
    tools:targetApi="q"
    tools:context=".ui.auth.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="760dp">

        <!-- IMAGEN DE FONDO (COCINERAS NÍTIDAS ARRIBA Y DIFUMINADAS ABAJO) -->
        <ImageView
            android:id="@+id/imgFondo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/fondo_sirae_blur"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TITULO SIRAE CON LÍNEA AMARILLA SUBRAYADA -->
        <LinearLayout
            android:id="@+id/layoutLogoSirae"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/guidelineBottomCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="SIRAE"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

            <View
                android:layout_width="64dp"
                android:layout_height="4.5dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_yellow_accent_bar" />
        </LinearLayout>

        <!-- LÍNEA GUÍA DONDE INICIA LA TARJETA OSCURA INFERIOR -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineBottomCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.42" />

        <!-- CONTENEDOR INFERIOR CURVADO (RECUADRO DIFUMINADO) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_login_bottom_sheet"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guidelineBottomCard">

            <!-- FORMULARIO DE INICIO DE SESIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- CAMPO CORREO ELECTRÓNICO (FORMA PÍLDORA) -->
                <LinearLayout
                    android:id="@+id/layoutCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_login_input_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Correo"
                        android:src="@drawable/ic_email_outline"
                        app:tint="#CBD5E1" />

                    <EditText
                        android:id="@+id/txtCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Correo electrónico"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#94A3B8"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <!-- CAMPO CONTRASEÑA (FORMA PÍLDORA) -->
                <LinearLayout
                    android:id="@+id/layoutPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:addStatesFromChildren="true"
                    android:background="@drawable/bg_login_input_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Contraseña"
                        android:src="@drawable/ic_lock_outline"
                        app:tint="#CBD5E1" />

                    <EditText
                        android:id="@+id/txtPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Contraseña"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#94A3B8"
                        android:textSize="14.5sp" />

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Ver contraseña"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_visibility_off_white"
                        app:tint="#CBD5E1" />
                </LinearLayout>

                <!-- ¿OLVIDASTE TU CONTRASEÑA? -->
                <TextView
                    android:id="@+id/txtOlvide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp"
                    android:text="¿Olvidaste tu contraseña?"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />

                <!-- BOTÓN INGRESAR CON FLECHA -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:elevation="0dp"
                    android:forceDarkAllowed="false"
                    android:stateListAnimator="@null"
                    android:text="Ingresar"
                    android:textAllCaps="false"
                    android:textColor="#181B1F"
                    android:textSize="16.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F4B41F"
                    android:backgroundTint="#F4B41F"
                    app:cornerRadius="27dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="#181B1F"
                    app:rippleColor="#30000000"
                    tools:targetApi="q" />

                <!-- MENSAJE DE CONTACTO CON ADMINISTRADOR -->
                <LinearLayout
                    android:id="@+id/layoutAdminContacto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="¿No tienes una cuenta?"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtAdministrador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Contacta con el administrador."
                        android:textColor="#CBD5E1"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>