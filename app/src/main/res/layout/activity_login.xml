<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F3"
    tools:context=".ui.auth.LoginActivity">

    <!-- ===================================================== -->
    <!-- FONDO                                                  -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_sirae"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================== -->
    <!-- CAPA SOBRE EL FONDO                                    -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/capaFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================== -->
    <!-- CONTENIDO SCROLLABLE                                   -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="60dp">

            <!-- ================================================= -->
            <!-- TARJETA LOGIN                                     -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="26dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="26dp"
                    android:paddingBottom="28dp">

                    <!-- ========================================= -->
                    <!-- LOGO                                       -->
                    <!-- ========================================= -->

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="180dp"
                        android:layout_height="82dp"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo SIRAE"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo_sirae" />

                    <!-- ========================================= -->
                    <!-- TITULO                                     -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Iniciar sesión"
                        android:textColor="#202020"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSubtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:text="Ingresa tus datos para continuar"
                        android:textColor="#777777"
                        android:textSize="13sp" />

                    <!-- ========================================= -->
                    <!-- CORREO                                     -->
                    <!-- ========================================= -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="Correo electrónico"
                        android:textColor="#303030"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="ejemplo@correo.com"
                        android:inputType="textEmailAddress"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:singleLine="true"
                        android:textColor="#222222"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <!-- ========================================= -->
                    <!-- CONTRASEÑA                                -->
                    <!-- ========================================= -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Contraseña"
                        android:textColor="#303030"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/txtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input"
                        android:hint="Ingresa tu contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:singleLine="true"
                        android:textColor="#222222"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <!-- ========================================= -->
                    <!-- OLVIDASTE CONTRASEÑA                      -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/txtOlvide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="@color/verde_sirae"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- ========================================= -->
                    <!-- BOTON INGRESAR                            -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/btnIngresar"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_btn_ingresar"
                        android:clickable="true"
                        android:elevation="3dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Ingresar"
                        android:textColor="@color/negro"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- ========================================= -->
                    <!-- REGISTRO                                  -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/txtNoCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:text="¿No tienes cuenta?"
                        android:textColor="#999999"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtAdministrador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Contacta al administrador"
                        android:textColor="@color/verde_sirae"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>