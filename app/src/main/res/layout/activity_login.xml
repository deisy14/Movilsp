<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    tools:context=".ui.auth.LoginActivity">

    <!-- FONDO DE ALIMENTOS -->
    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/sirae_fondo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CAPA DEL FONDO: transparente -->
    <View
        android:id="@+id/capaFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENIDO DESPLAZABLE -->
    <ScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp">

            <!-- TARJETA LOGIN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="26dp"
                    android:paddingTop="32dp"
                    android:paddingEnd="26dp"
                    android:paddingBottom="32dp">

                    <!-- LOGO SIRAE -->
                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo SIRAE"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo_sirae" />

                    <!-- TÍTULO -->
                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Iniciar sesión"
                        android:textColor="#1B3317"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- SUBTÍTULO -->
                    <TextView
                        android:id="@+id/txtSubtitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Ingresa tus credenciales para continuar"
                        android:textColor="#52685B"
                        android:textSize="13sp" />

                    <!-- ETIQUETA CORREO -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Correo electrónico"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- CAMPO CORREO -->
                    <EditText
                        android:id="@+id/txtCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="ejemplo@correo.com"
                        android:inputType="textEmailAddress"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#1B3317"
                        android:textColorHint="#64776B"
                        android:textSize="14sp" />

                    <!-- ETIQUETA CONTRASEÑA -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Contraseña"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- CAMPO CONTRASEÑA -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/txtPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_edittext"
                            android:hint="Ingresa tu contraseña"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="48dp"
                            android:singleLine="true"
                            android:textColor="#1B3317"
                            android:textColorHint="#64776B"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/btnTogglePassword"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Mostrar u ocultar contraseña"
                            android:focusable="true"
                            android:padding="8dp"
                            android:src="@drawable/ic_visibility_off" />

                    </FrameLayout>

                    <!-- OLVIDÉ MI CONTRASEÑA -->
                    <TextView
                        android:id="@+id/txtOlvide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="¿Olvidaste tu contraseña?"
                        android:textColor="#1B3317"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- BOTÓN INGRESAR -->
                    <!-- AMARILLO SIRAE: #F4B41F -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIngresar"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#F4B41F"
                        android:text="Ingresar al Sistema"
                        android:textColor="#1B3317"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:elevation="2dp"
                        app:rippleColor="#40FFFFFF" />

                    <!-- MENSAJE DE REGISTRO -->
                    <TextView
                        android:id="@+id/txtNoCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="¿No tienes cuenta?"
                        android:textColor="#52685B"
                        android:textSize="12sp" />

                    <!-- CONTACTO ADMINISTRADOR -->
                    <TextView
                        android:id="@+id/txtAdministrador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Contacta al administrador"
                        android:textColor="#1B3317"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
