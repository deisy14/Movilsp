<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181D24"
    android:fillViewport="true"
    android:fitsSystemWindows="false"
    tools:context=".ui.auth.LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- FOTO DE FONDO CON COCINERAS ARRIBA Y DESENFOQUE VIDRIO ABAJO -->
        <ImageView
            android:id="@+id/imgFondo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/fondo_sirae"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- LÍNEA GUÍA: SUBIDO ~2MM ADICIONALES (0.498 DEL ALTO) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelinePanalHuevos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.498" />

        <!-- RECUADRO DE VIDRIO DE BORDE A BORDE Y HASTA EL FINAL DE LA IMAGEN/PANTALLA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_min="wrap"
            android:background="@drawable/bg_glass_card_login"
            android:paddingHorizontal="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guidelinePanalHuevos">

            <!-- LOGO SIRAE CON LÍNEA AMARILLA SUBRAYADA ADENTRO DEL VIDRIO -->
            <LinearLayout
                android:id="@+id/layoutLogoSirae"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="SIRAE"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="50dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_yellow_accent_bar" />
            </LinearLayout>

            <!-- CAMPO CORREO ELECTRÓNICO (CÁPSULA VIDRIO) -->
            <LinearLayout
                android:id="@+id/layoutCorreo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_login_input_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                app:layout_constraintTop_toBottomOf="@+id/layoutLogoSirae">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Correo"
                    android:src="@drawable/ic_email_outline"
                    app:tint="#CBD5E1" />

                <EditText
                    android:id="@+id/txtCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Correo electrónico"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CAMPO CONTRASEÑA (CÁPSULA VIDRIO) -->
            <LinearLayout
                android:id="@+id/layoutPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_login_input_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                app:layout_constraintTop_toBottomOf="@+id/layoutCorreo">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Contraseña"
                    android:src="@drawable/ic_lock_outline"
                    app:tint="#CBD5E1" />

                <EditText
                    android:id="@+id/txtPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Contraseña"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Ver contraseña"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_visibility_off_white"
                    app:tint="#CBD5E1" />
            </LinearLayout>

            <!-- ¿OLVIDASTE TU CONTRASEÑA? -->
            <TextView
                android:id="@+id/txtOlvide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="2dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutPassword" />

            <!-- BOTÓN INGRESAR CON FLECHA (AMARILLO EXACTO A LA FOTO) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#F4B41F"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text="Ingresar"
                android:textAllCaps="false"
                android:textColor="#181B1F"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#F4B41F"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconSize="18dp"
                app:iconTint="#181B1F"
                app:layout_constraintTop_toBottomOf="@+id/txtOlvide"
                app:rippleColor="#30000000" />

            <!-- MENSAJE DE CONTACTO CON ADMINISTRADOR -->
            <LinearLayout
                android:id="@+id/layoutAdminContacto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnIngresar"
                app:layout_constraintVertical_bias="0.5">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¿No tienes una cuenta?"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAdministrador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:text="Contacta con el administrador."
                    android:textColor="#CBD5E1"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>