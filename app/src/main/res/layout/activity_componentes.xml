<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- =============================== -->
            <!-- BARRA SUPERIOR -->
            <!-- =============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Volver"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#173F2A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SIRAE"
                    android:textColor="#176B35"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

            </LinearLayout>


            <!-- =============================== -->
            <!-- TITULO -->
            <!-- =============================== -->

            <TextView
                android:id="@+id/tvTituloSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Componentes del desayuno"
                android:textColor="#173F2A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Conoce los ingredientes de cada plato"
                android:textColor="#65736A"
                android:textSize="14sp" />


            <!-- =============================== -->
            <!-- CARD DESTACADA: PLATO ASIGNADO -->
            <!-- =============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_seccion_seleccionada"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgPlato"
                    android:layout_width="130dp"
                    android:layout_height="110dp"
                    android:contentDescription="Imagen del plato"
                    android:scaleType="centerCrop"
                    android:src="@drawable/chocolate" />

                <TextView
                    android:id="@+id/tvNombrePlato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Chocolate"
                    android:textColor="#173F2A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_asignado"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="Asignado"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- =============================== -->
            <!-- COMPONENTES -->
            <!-- =============================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Componentes"
                android:textColor="#173F2A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- CONTENEDOR DINÁMICO DE COMPONENTES -->
            <LinearLayout
                android:id="@+id/contenedorComponentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


            <!-- LECHE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_fila_lista"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Leche"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_leche" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Leche"
                    android:textColor="#34443A"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CHOCOLATE EN POLVO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_fila_lista"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Chocolate en polvo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_chocolate_polvo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Chocolate en polvo"
                    android:textColor="#34443A"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- AZUCAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_fila_lista"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Azúcar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_azucar" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Azúcar"
                    android:textColor="#34443A"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CANELA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_fila_lista"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Canela"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_canela" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Canela"
                    android:textColor="#34443A"
                    android:textSize="14sp" />

            </LinearLayout>

            </LinearLayout>


            <!-- =============================== -->
            <!-- BOTÓN -->
            <!-- =============================== -->

            <Button
                android:id="@+id/btnVerIngredientes"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#FFD928"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Ver ingredientes     ›"
                android:textAllCaps="false"
                android:textColor="#173F2A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Espacio para que el último contenido -->
            <!-- no quede oculto detrás de la barra -->

            <View
                android:layout_width="match_parent"
                android:layout_height="90dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ===================================== -->
    <!-- BARRA INFERIOR FIJA -->
    <!-- ===================================== -->

    <include
        android:id="@+id/barra_navegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>