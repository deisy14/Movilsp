<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootRedactarReceta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical">

    <!-- ENCABEZADO SUPERIOR -->
    <LinearLayout
        android:id="@+id/headerRedactar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icono_circular"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1B3317" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Redactar Receta"
                android:textColor="#1B3317"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Agrega una nueva receta al menú PAE"
                android:textColor="#65736A"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- FORMULARIO SCROLLABLE -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA 1: DATOS PRINCIPALES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#EDEDED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATOS GENERALES"
                        android:textColor="#F4B41F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Nombre del plato -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nombre del Plato *"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNombrePlato"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_campo"
                        android:hint="Ej. Pollo Guisado Criollo"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textColor="#111111"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <!-- Momento de la Jornada -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Jornada / Momento del Menú *"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgMomentoMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbAlmuerzo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Almuerzo"
                            android:textColor="#1B3317"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbDesayuno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Desayuno"
                            android:textColor="#1B3317"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbRefrigerio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="Refrigerio"
                            android:textColor="#1B3317"
                            android:textSize="13sp" />

                    </RadioGroup>

                    <!-- Tiempo estimado y porciones -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tiempo Estimado"
                                android:textColor="#1B3317"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etTiempoPreparacion"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_campo"
                                android:hint="Ej. 45 min"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:textColor="#111111"
                                android:textColorHint="#999999"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Porciones Estimadas"
                                android:textColor="#1B3317"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etPorciones"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_campo"
                                android:hint="Ej. 120 raciones"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:textColor="#111111"
                                android:textColorHint="#999999"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 2: INGREDIENTES -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#EDEDED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INGREDIENTES *"
                        android:textColor="#F4B41F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Especifica cada insumo e ingrediente requerido para la preparación."
                        android:textColor="#65736A"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etIngredientes"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_campo"
                        android:gravity="top|start"
                        android:hint="Ej. Pollo 10kg, Papas 8kg, Cebolla cabezona 2kg, Tomate 2kg, Sal y condimentos..."
                        android:inputType="textMultiLine"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:textColor="#111111"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA 3: PASOS DE PREPARACIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="#EDEDED"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASOS DE PREPARACIÓN *"
                        android:textColor="#F4B41F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Describe la guía paso a paso para el personal manipulador."
                        android:textColor="#65736A"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etInstrucciones"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_campo"
                        android:gravity="top|start"
                        android:hint="1. Lavar y desinfectar todos los ingredientes.\n2. Poner a hervir el agua y condimentar al gusto.\n3. Incorporar las piezas de pollo y dejar a fuego medio..."
                        android:inputType="textMultiLine"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp"
                        android:textColor="#111111"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BOTONES DE ACCIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarReceta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#F4B41F"
                android:text="Guardar Receta"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#65736A"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                app:strokeColor="#D0D5DD"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
