<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.InventarioJefaActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="30dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Volver"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#1B3317" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INVENTARIO DE INSUMOS PAE"
                        android:textColor="#1B3317"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtJornadaTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Control general de alimentos en bodega y cocina"
                        android:textColor="#3D5C37"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- 3 BOTONES DE CATEGORÍAS HORIZONTALMENTE (GRANOS, LÁCTEOS, VERDURAS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- BOTÓN 1: GRANOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoriaGranos"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Granos"
                    android:textAllCaps="false"
                    android:textColor="#1B3317"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp" />

                <!-- BOTÓN 2: LÁCTEOS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoriaLacteos"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Lácteos"
                    android:textAllCaps="false"
                    android:textColor="#1B3317"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp" />

                <!-- BOTÓN 3: VERDURAS -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoriaVerduras"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Verduras"
                    android:textAllCaps="false"
                    android:textColor="#1B3317"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

            <!-- ENCABEZADO DE PRODUCTOS DEL ADMIN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTituloSeccionProductos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Inventario del Administrador"
                    android:textColor="#1B3317"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtConteoProductos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos los insumos"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LISTA DE PRODUCTOS DEL ADMIN -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_producto_admin" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA NAVEGACIÓN EXCLUSIVA JEFA -->
    <include
        android:id="@+id/barra_navegacion_jefa"
        layout="@layout/view_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>