<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="@color/blanco">

    <!-- ===================================================== -->
    <!-- CONTENIDO                                             -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVolver"

                    android:layout_width="44dp"
                    android:layout_height="44dp"

                    android:background="@drawable/bg_icono_circular"

                    android:padding="10dp"

                    android:src="@drawable/ic_arrow_back"

                    android:tint="@color/negro_principal"

                    android:contentDescription="Volver"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="12dp"

                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Inventario"

                        android:textColor="@color/negro_principal"

                        android:textSize="23sp"

                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtJornadaTitulo"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="Control de alimentos"

                        android:textColor="@color/gris_texto"

                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- JORNADA                                           -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:text="Jornada"

                android:textColor="@color/negro_principal"

                android:textSize="17sp"

                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:layout_marginTop="10dp"

                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnManana"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:text="Mañana"

                    android:textColor="@color/blanco"

                    android:textStyle="bold"

                    android:backgroundTint="@color/amarillo_principal"/>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>

                <Button
                    android:id="@+id/btnTarde"

                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:text="Tarde"

                    android:textColor="@color/negro_principal"

                    android:textStyle="bold"

                    android:backgroundTint="@color/gris_claro"/>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- SUGERENCIA IA                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/btnGenerarIA"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"

                android:orientation="vertical"

                android:padding="18dp"

                android:background="@drawable/bg_card_ia"

                android:clickable="true"

                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"

                        android:padding="9dp"

                        android:background="@drawable/bg_icono_amarillo"

                        android:src="@drawable/ic_food"

                        android:tint="@color/negro_principal"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:layout_marginStart="12dp"

                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Sugerencia de IA"

                            android:textColor="@color/negro_principal"

                            android:textSize="18sp"

                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="Generar platos según asistencia e inventario"

                            android:textColor="@color/gris_texto"

                            android:textSize="12sp"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"

                        android:src="@drawable/ic_arrow_forward"

                        android:tint="@color/amarillo_principal"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- RESUMEN INVENTARIO                                 -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:text="Inventario actual"

                android:textColor="@color/negro_principal"

                android:textSize="18sp"

                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"

                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"

                    android:layout_weight="1"

                    android:orientation="vertical"

                    android:gravity="center"

                    android:background="@drawable/bg_resumen">

                    <TextView
                        android:id="@+id/txtCantidadAlimentos"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0 alimentos registrados"

                        android:textColor="@color/negro_principal"

                        android:textSize="13sp"

                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="Alimentos"

                        android:textColor="@color/gris_texto"

                        android:textSize="11sp"/>

                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="90dp"

                    android:layout_weight="1"

                    android:orientation="vertical"

                    android:gravity="center"

                    android:background="@drawable/bg_resumen">

                    <TextView
                        android:id="@+id/txtTotalInventario"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0.0 kg disponibles"

                        android:textColor="@color/negro_principal"

                        android:textSize="13sp"

                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="Cantidad total"

                        android:textColor="@color/gris_texto"

                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- ESTADO                                             -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:gravity="center_vertical"

                android:padding="14dp"

                android:background="@drawable/bg_info">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"

                    android:padding="7dp"

                    android:background="@drawable/bg_icono_rojo"

                    android:src="@drawable/ic_status"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:layout_marginStart="10dp"

                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Estado del inventario"

                        android:textColor="@color/gris_texto"

                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtEstadoInventario"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="Pendiente de registrar"

                        android:textColor="@color/rojo_principal"

                        android:textSize="14sp"

                        android:textStyle="bold"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ================================================= -->
            <!-- REGISTRAR ENTREGA                                 -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnRegistrarEntrega"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="18dp"

                android:text="Registrar entrega del supervisor"

                android:textColor="@color/blanco"

                android:textSize="14sp"

                android:textStyle="bold"

                android:backgroundTint="@color/amarillo_principal"/>

            <!-- ================================================= -->
            <!-- MOVIMIENTOS                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/btnMovimientos"

                android:layout_width="match_parent"
                android:layout_height="60dp"

                android:layout_marginTop="12dp"

                android:gravity="center_vertical"

                android:paddingStart="14dp"
                android:paddingEnd="14dp"

                android:background="@drawable/bg_card_resumen"

                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"

                    android:padding="8dp"

                    android:background="@drawable/bg_icono_verde"

                    android:src="@drawable/ic_status"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Movimientos alimentarios"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_arrow_forward"
                    android:tint="@color/gris_texto"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/barra_navegacion_jefa"
        android:layout_width="match_parent"
        android:layout_height="88dp"/>

</LinearLayout>