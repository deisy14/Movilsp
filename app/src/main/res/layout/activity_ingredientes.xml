<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    tools:context=".ui.manipuladora.IngredientesActivity">

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- SUB-ENCABEZADO: FLECHA ATRÁS, TÍTULO Y RACIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnVolver"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volver"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#1E293B" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingredientes"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cantidades, marca y sazón de cada ingr..."
                        android:textColor="#64748B"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvRacionesIngredientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_light_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="— raciones"
                    android:textColor="#2B5424"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TARJETA BLANCA CON CABECERA VERDE Y BORDE DORADO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#F5B81F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- CABECERA VERDE DE BORDE A BORDE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#2B5424"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DESAYUNO · CONTROL DE GRAMAJE"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDesgloseIngredientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prim: — · Sec: —"
                            android:textColor="#FFFFFF"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- CUERPO BLANCO DE LA TARJETA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- FOTO DEL PLATO CON BORDE DORADO -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#F4B41F"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgPlatoIngredientes"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Imagen del plato"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/plato3" />

                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNombrePlatoIngredientes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando plato..."
                                    android:textColor="#1E293B"
                                    android:textSize="16.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvComponenteSubtitulo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Estación pendiente de asignación"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />

                                <!-- BOTÓN ASIGNAR ESTACIÓN (AMARILLO SUAVE #FEF9E7 CON BORDE DORADO) -->
                                <com.google.android.material.button.MaterialButton
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="8dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="Asignar estación"
                                    android:textAllCaps="false"
                                    android:textColor="#7A5500"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="#FEF9E7"
                                    app:cornerRadius="10dp"
                                    app:strokeColor="#F4B41F"
                                    app:strokeWidth="1dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TÍTULO: TABLA DE INGREDIENTES Y SAZÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Tabla de Ingredientes y Sazón"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nombre, marca y función de sabor para dar sazón al plato"
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- CHIPS DE FILTRO (TODOS / BASE DEL PLATO / SAZÓN) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_plato"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Todos"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipBasePlato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Base del plato"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipSazon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tag_plato"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Sazón"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ENCABEZADO DE TABLA (BANNER VERDE OSCURO #1B3317) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#1B3317"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="INGREDIENTE, MARCA Y SAZÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CANTIDAD"
                        android:textColor="#F4B41F"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LISTA DE INGREDIENTES DINÁMICA -->
            <LinearLayout
                android:id="@+id/contenedorIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- BANNER: INGREDIENTES APROBADOS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#E8F5E9"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#15803D"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Aprobado"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#15803D" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ingredientes aprobados"
                            android:textColor="#1B3317"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Todos los ingredientes cuentan con el certificado de calidad e inocuidad PAE."
                            android:textColor="#2A5226"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN: CONTINUAR A PREPARACIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuarPreparacion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F4B41F"
                android:text="Continuar a preparación"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
