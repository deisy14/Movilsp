<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ===================================== -->
    <!-- CONTENIDO QUE SE PUEDE DESLIZAR -->
    <!-- ===================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- =============================== -->
            <!-- BARRA SUPERIOR -->
            <!-- =============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Volver"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#173F2A" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SIRAE"
                    android:textColor="#176B35"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp" />

            </LinearLayout>


            <!-- =============================== -->
            <!-- TITULO -->
            <!-- =============================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ingredientes"
                android:textColor="#173F2A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cantidades y unidades de cada ingrediente"
                android:textColor="#65736A"
                android:textSize="14sp" />


            <!-- =============================== -->
            <!-- CARD DESTACADA: PLATO ASIGNADO -->
            <!-- =============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_seccion_seleccionada"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/imgPlatoIngredientes"
                    android:layout_width="130dp"
                    android:layout_height="110dp"
                    android:contentDescription="Imagen del plato"
                    android:scaleType="centerCrop"
                    android:src="@drawable/chocolate" />

                <TextView
                    android:id="@+id/tvNombrePlatoIngredientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Cargando..."
                    android:textColor="#173F2A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvComponenteSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Componente seleccionado"
                    android:textColor="#176B35"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_asignado"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp"
                    android:text="Asignado"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- =============================== -->
            <!-- LISTA DE INGREDIENTES -->
            <!-- =============================== -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tabla de ingredientes y sazón"
                android:textColor="#173F2A"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Nombre, marca y función de sabor para dar sazón al plato:"
                android:textColor="#65736A"
                android:textSize="13sp" />

            <!-- Lista de ingredientes dinámica desde el backend -->
            <LinearLayout
                android:id="@+id/contenedorIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />


            <!-- =============================== -->
            <!-- BANNER: INGREDIENTES APROBADOS -->
            <!-- =============================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_banner_aprobado"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Aprobado"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#176B35" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingredientes aprobados"
                        android:textColor="#173F2A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Todos los ingredientes cuentan con el certificado de calidad."
                        android:textColor="#4A5A4F"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- =============================== -->
            <!-- BOTÓN -->
            <!-- =============================== -->

            <Button
                android:id="@+id/btnContinuarPreparacion"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FFD928"
                android:text="Continuar a preparación     ›"
                android:textAllCaps="false"
                android:textColor="#173F2A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Espacio para que el último contenido -->
            <!-- no quede oculto detrás de la barra -->

            <View
                android:layout_width="match_parent"
                android:layout_height="90dp" />

        </LinearLayout>

    </ScrollView>


    <!-- ===================================== -->
    <!-- BARRA INFERIOR FIJA -->
    <!-- ===================================== -->

    <include
        layout="@layout/activity_barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</FrameLayout>