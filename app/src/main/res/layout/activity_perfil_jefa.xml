<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.PerfilJefaActivity">

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- TARJETA PRINCIPAL DE PERFIL CON BORDE AMARILLO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- FOTO DE PERFIL / AVATAR CON BOTÓN PARA AGREGAR/CAMBIAR FOTO -->
                    <LinearLayout
                        android:id="@+id/btnCambiarFotoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgFotoPerfil"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_gravity="center"
                                android:background="#F8FAFC"
                                android:padding="18dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_nav_perfil"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                                app:strokeColor="#CBD5E1"
                                app:strokeWidth="1dp" />

                            <!-- BADGE / ÍCONO DE CÁMARA AMARILLO -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="bottom|end"
                                app:cardBackgroundColor="#F4B41F"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="4dp"
                                app:strokeColor="#FFFFFF"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Cambiar foto"
                                    android:src="@drawable/ic_editar"
                                    app:tint="#1B3317" />
                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtNombreJefa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Isa Pérez"
                            android:textColor="#1E293B"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCargo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Jefa de Manipuladoras"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- LÍNEA DIVISORA -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="12dp"
                        android:background="#F1F5F9" />

                    <!-- DATOS DE CONTACTO (NOMBRE, CORREO, TELÉFONO) -->
                    <!-- NOMBRE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_icono_circular"
                            android:backgroundTint="#F8FAFC"
                            android:contentDescription="Nombre"
                            android:padding="9dp"
                            android:src="@drawable/ic_nav_perfil"
                            app:tint="#1E293B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nombre"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtNombre"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Isa Pérez"
                                android:textColor="#1E293B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- CORREO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_icono_circular"
                            android:backgroundTint="#F8FAFC"
                            android:contentDescription="Correo"
                            android:padding="9dp"
                            android:src="@drawable/ic_email"
                            app:tint="#1E293B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Correo electrónico"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtCorreo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Isaperez@gmail.com"
                                android:textColor="#1E293B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- TELÉFONO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_icono_circular"
                            android:backgroundTint="#F8FAFC"
                            android:contentDescription="Teléfono"
                            android:padding="9dp"
                            android:src="@drawable/ic_phone"
                            app:tint="#1E293B" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Teléfono"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtTelefono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="No registrado"
                                android:textColor="#1E293B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN CONFIGURACIÓN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Configuración"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- BOTÓN 1: EDITAR PERFIL CON BORDE AMARILLO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_circular"
                        android:backgroundTint="#FFFBEB"
                        android:contentDescription="Editar perfil"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1E293B" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Editar perfil"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#64748B" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN 2: NOTIFICACIONES CON BORDE AMARILLO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnConfiguracionNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_circular"
                        android:backgroundTint="#FFFBEB"
                        android:contentDescription="Notificaciones"
                        android:padding="9dp"
                        android:src="@drawable/ic_notificaciones"
                        app:tint="#1E293B" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Notificaciones"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#64748B" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN CERRAR SESIÓN EN AMARILLO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#F4B41F"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="2dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA NAVEGACIÓN EXCLUSIVA JEFA -->
    <include
        android:id="@+id/barra_navegacion_jefa"
        layout="@layout/view_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>