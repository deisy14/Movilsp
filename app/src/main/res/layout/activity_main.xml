<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4B41F">

    <!-- SALUDO -->
    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BIENVENIDA"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp" />

    <!-- FECHA -->
    <TextView
        android:id="@+id/tvFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LUNES / 7 / JUN / 2026"
        android:textColor="#98A2B3"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvSaludo"
        app:layout_constraintStart_toStartOf="@id/tvSaludo"
        android:layout_marginTop="2dp" />

    <!-- TITULO -->
    <TextView
        android:id="@+id/tvTituloMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MENÚ DIARIO"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/tvFecha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />

    <!-- CONTENIDO BLANCO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/fondo_blanco_superior"
        android:paddingTop="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvTituloMenu"
        app:layout_constraintBottom_toTopOf="@id/barra_navegacion"
        android:layout_marginTop="10dp">

        <!-- PREGUNTA -->
        <TextView
            android:id="@+id/tvPregunta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú seleccionado"
            android:textColor="#667085"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- SUGERENCIAS -->
        <TextView
            android:id="@+id/tvSugerencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sugerencias para hoy"
            android:textColor="#344054"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvPregunta"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp" />

        <!-- RUEDA -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wheelContainer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvSugerencias"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- FONDO DE LA RUEDA -->
            <View
                android:id="@+id/fondoRueda"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/circulo_amarillo" />

            <!-- PLATO ARRIBA -->
            <ImageView
                android:id="@+id/platoArriba"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circulo_blanco_sombra"
                android:contentDescription="Plato de arriba"
                android:scaleType="centerCrop"
                android:src="@drawable/apanado"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="-12dp" />

            <!-- PLATO IZQUIERDA -->
            <ImageView
                android:id="@+id/platoIzquierda"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circulo_blanco_sombra"
                android:contentDescription="Plato de la izquierda"
                android:scaleType="centerCrop"
                android:src="@drawable/frijoles"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="-12dp" />

            <!-- PLATO DERECHA -->
            <ImageView
                android:id="@+id/platoDerecha"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circulo_blanco_sombra"
                android:contentDescription="Plato de la derecha"
                android:scaleType="centerCrop"
                android:src="@drawable/apanado"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="-12dp" />

            <!-- PLATO ABAJO -->
            <ImageView
                android:id="@+id/platoAbajo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/circulo_blanco_sombra"
                android:contentDescription="Plato de abajo"
                android:scaleType="centerCrop"
                android:src="@drawable/frijoles"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="-12dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TARJETA DEL PLATO SELECCIONADO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPlatoSeleccionado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="64dp"
            android:layout_marginTop="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/wheelContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:strokeColor="#FFC107"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvPlatoSeleccionado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sopa de Frijoles"
                    android:textColor="#1D2939"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIngredientes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="• Ingredientes disponibles"
                    android:textColor="#039855"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- MENUS ANTERIORES -->
        <TextView
            android:id="@+id/tvMenusAnteriores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menús anteriores"
            android:textColor="#1D2939"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardPlatoSeleccionado"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="24dp"
            android:layout_marginTop="10dp" />

        <!-- TARJETAS ANTERIORES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvMenusAnteriores">

            <!-- TARJETA 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Arroz con pollo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/frijoles" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Lun 19"
                        android:textColor="#667085"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Arroz con pollo"
                        android:textColor="#1D2939"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TARJETA 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Pasta con carne"
                        android:scaleType="centerCrop"
                        android:src="@drawable/apanado" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mar 20"
                        android:textColor="#667085"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Pasta con carne"
                        android:textColor="#1D2939"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TARJETA 3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#EAECF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="Lentejas"
                        android:scaleType="centerCrop"
                        android:src="@drawable/frijoles" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mié 21"
                        android:textColor="#667085"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Lentejas"
                        android:textColor="#1D2939"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BARRA DE NAVEGACIÓN -->
    <include
        android:id="@+id/barra_navegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

