<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ===================================================== -->
    <!-- CABECERA                                               -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIENVENIDA"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="LUNES / 7 / JUN / 2026"
            android:textColor="#3F3F3F"
            android:textSize="12sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- TITULO PRINCIPAL                                      -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvTituloMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="MENÚ DIARIO"
        android:textColor="#111111"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- CONTENIDO PRINCIPAL                                   -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/fondo_blanco_superior"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloMenu"
        app:layout_constraintBottom_toTopOf="@id/barra_navegacion">

        <!-- ================================================= -->
        <!-- SUGERENCIAS                                        -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvSugerencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Sugerencias para hoy"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- ================================================= -->
        <!-- ZONA DE RULETA + INFORMACIÓN DEL MENÚ             -->
        <!-- ================================================= -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wheelArea"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvSugerencias"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- ================================================= -->
            <!-- RULETA                                             -->
            <!-- ================================================= -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wheelContainer"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_marginStart="-80dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <View
                    android:id="@+id/fondoRueda"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/circulo_amarillo" />


                <!-- ============================================= -->
                <!-- DESAYUNO                                        -->
                <!-- ============================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDesayuno"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E7B84A"
                    app:strokeWidth="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/imgRuletaDesayuno"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Desayuno"
                        android:scaleType="centerCrop"
                        android:src="@drawable/apanado" />

                </com.google.android.material.card.MaterialCardView>


                <!-- ============================================= -->
                <!-- ALMUERZO                                        -->
                <!-- ============================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlmuerzo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E7B84A"
                    app:strokeWidth="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/imgRuletaAlmuerzo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Almuerzo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/frijoles" />

                </com.google.android.material.card.MaterialCardView>


                <!-- ============================================= -->
                <!-- MERIENDA                                        -->
                <!-- ============================================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMerienda"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E7B84A"
                    app:strokeWidth="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/imgRuletaMerienda"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Merienda"
                        android:scaleType="centerCrop"
                        android:src="@drawable/apanado" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- ================================================= -->
            <!-- INFORMACIÓN DE LA SECCIÓN SELECCIONADA           -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlatoSeleccionado"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:strokeColor="#E7B84A"
                app:strokeWidth="2dp"
                app:layout_constraintStart_toEndOf="@id/wheelContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/wheelContainer"
                app:layout_constraintBottom_toBottomOf="@id/wheelContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- SECCIÓN SELECCIONADA -->

                    <TextView
                        android:id="@+id/tvSeccionSeleccionada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESAYUNO"
                        android:textColor="#596B35"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- PLATO QUE CORRESPONDE A LA SECCIÓN -->

                    <TextView
                        android:id="@+id/tvPlatoSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Sopa de Frijoles"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- INFORMACIÓN -->

                    <TextView
                        android:id="@+id/tvIngredientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Menú de hoy"
                        android:textColor="#596B35"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- ================================================= -->
        <!-- DIVISOR                                            -->
        <!-- ================================================= -->

        <View
            android:id="@+id/dividerMenus"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="#EAECF0"
            app:layout_constraintTop_toBottomOf="@id/wheelArea" />


        <!-- ================================================= -->
        <!-- MENUS ANTERIORES                                   -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvMenusAnteriores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:text="Menús anteriores"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/dividerMenus"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- ================================================= -->
        <!-- TARJETAS ANTERIORES                                -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvMenusAnteriores">

            <!-- TARJETA 1 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenuAnterior1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E7B84A"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:id="@+id/imgMenuAnterior1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Arroz con pollo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/frijoles" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvFechaAnterior1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Lun 19"
                        android:textColor="#667085"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPlatoAnterior1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Arroz con pollo"
                        android:textColor="#111111"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- TARJETA 2 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenuAnterior2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E7B84A"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:id="@+id/imgMenuAnterior2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Bandeja paisa"
                            android:scaleType="centerCrop"
                            android:src="@drawable/apanado" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvFechaAnterior2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mar 20"
                        android:textColor="#667085"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPlatoAnterior2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Bandeja paisa"
                        android:textColor="#111111"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- TARJETA 3 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMenuAnterior3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E7B84A"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="1.5dp">

                        <ImageView
                            android:id="@+id/imgMenuAnterior3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Lentejas"
                            android:scaleType="centerCrop"
                            android:src="@drawable/frijoles" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvFechaAnterior3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mié 21"
                        android:textColor="#667085"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvPlatoAnterior3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Lentejas"
                        android:textColor="#111111"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- BARRA INFERIOR                                        -->
    <!-- ===================================================== -->

    <include
        android:id="@+id/barra_navegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>