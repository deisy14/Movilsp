<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5">

    <!-- CONTENIDO PRINCIPAL CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barra_navegacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp">

            <!-- CABECERA AMARILLA -->
            <View
                android:id="@+id/bgHeader"
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:background="@drawable/bg_header_curved"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- LOGO PAE -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutLogoPae"
                android:layout_width="120dp"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="58dp"
                android:background="@drawable/bg_logo_pae"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/imgLogoPae"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="PAE"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_sirae" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- INFORMACIÓN DEL USUARIO -->
            <LinearLayout
                android:id="@+id/layoutUsuarioHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="@id/layoutLogoPae"
                app:layout_constraintStart_toEndOf="@id/layoutLogoPae"
                app:layout_constraintEnd_toStartOf="@id/layoutAccionesHeader">

                <TextView
                    android:id="@+id/tvBienvenidaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="BIENVENIDA"
                    android:textColor="#1B3317"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="María López"
                    android:textColor="#1B3317"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manipuladora de Alimentos"
                    android:textColor="#355230"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="LUNES / 7 / JUN / 2026"
                    android:textColor="#3D5C37"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- ACCIONES DEL ENCABEZADO (NOTIFICACIONES Y PERFIL) -->
            <LinearLayout
                android:id="@+id/layoutAccionesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="@id/layoutLogoPae"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- NOTIFICACIONES -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imgCampana"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Notificaciones"
                            android:src="@drawable/ic_notificaciones"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <View
                            android:id="@+id/viewRedDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_icono_circular"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SELECTOR DE JORNADA -->
            <LinearLayout
                android:id="@+id/contenedorJornadasInicio"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_tag_plato"
                android:orientation="horizontal"
                android:padding="3dp"
                app:layout_constraintTop_toBottomOf="@id/layoutLogoPae"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/btnJornadaManana"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_yellow"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Mañana"
                    android:textColor="#7A5500"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnJornadaTarde"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Tarde"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- RULETA SEMICIRCULAR HORIZONTAL -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wheelAreaContainer"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/contenedorJornadasInicio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/wheelContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.example.movilmanupuladora.ui.manipuladora.CircularWheelView
                        android:id="@+id/circularWheelView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- ALMUERZO (CENTRO / SUPERIOR) -->
                    <LinearLayout
                        android:id="@+id/btnSeccionAlmuerzo"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginTop="52dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvLabelAlmuerzo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Almuerzo"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAlmuerzo"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="29dp"
                            app:cardElevation="5dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="2.5dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgRuletaAlmuerzo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Almuerzo"
                                android:scaleType="centerCrop"
                                android:src="@drawable/plato4"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- DESAYUNO (IZQUIERDA) -->

                    <!-- MERIENDA (DERECHA) -->

                    <LinearLayout
                        android:id="@+id/btnSeccionDesayuno"
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="52dp"
                        android:layout_marginTop="124dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvLabelDesayuno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Desayuno"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDesayuno"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="29dp"
                            app:cardElevation="5dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="2.5dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgRuletaDesayuno"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Desayuno"
                                android:scaleType="centerCrop"
                                android:src="@drawable/comida_desayuno"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnSeccionMerienda"
                        android:layout_width="85dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="132dp"
                        android:layout_marginEnd="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvLabelMerienda"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Merienda"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardMerienda"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="29dp"
                            app:cardElevation="5dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                            app:strokeColor="#FFFFFF"
                            app:strokeWidth="2.5dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgRuletaMerienda"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Merienda"
                                android:scaleType="centerCrop"
                                android:src="@drawable/comida_merienda"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- DETALLE DE LA SECCIÓN SELECCIONADA -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutDetalleSeccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@id/wheelAreaContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvTagSeccionSeleccionada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_yellow"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="5dp"
                    android:text="SECCIÓN SELECCIONADA"
                    android:textColor="#7A5500"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvSeccionSeleccionada"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="DESAYUNO"
                    android:textColor="#1B3317"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvTagSeccionSeleccionada"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvPlatoSeleccionado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_tag_plato"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:text="Plato asignado"
                    android:textColor="#1B3317"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tvSeccionSeleccionada"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Badge visible para el componente a preparar de la manipuladora -->
                <LinearLayout
                    android:id="@+id/layoutComponenteAsignado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tag_plato"
                    android:backgroundTint="#EDF7ED"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/tvPlatoSeleccionado"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥣 "
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvComponenteAsignado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu componente a preparar: Cargando..."
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPlatoMain"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutComponenteAsignado"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/imgPlatoMain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Plato principal"
                        android:scaleType="centerCrop"
                        android:src="@drawable/plato5" />

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerPreparacion"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#F4B41F"
                    android:text="Ver preparación"
                    android:textColor="#1B3317"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/cardPlatoMain"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- CARD 1: SUMATORIA DE ASISTENCIA PAE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAsistenciaSumatoria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/layoutDetalleSeccion"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Asistencia"
                        android:padding="9dp"
                        android:src="@drawable/ic_people"
                        app:tint="#1B3317" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CANTIDAD DE NIÑOS REGISTRADA"
                            android:textColor="#7A5500"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalAsistenciaSumatoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sin datos de asistencia"
                            android:textColor="#1B3317"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDesgloseAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dato suministrado por la jefa"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CARD 2: PREPARACIONES ASIGNADAS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccesoAsignadas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/cardAsistenciaSumatoria"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pill_green"
                        android:contentDescription="Preparación"
                        android:padding="9dp"
                        android:src="@drawable/ic_food"
                        app:tint="#2A5226" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTADO DE LA JORNADA Y PREPARACIÓN"
                            android:textColor="#2A5226"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSubtituloCardAsignadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Continuar preparación de hoy"
                            android:textColor="#1B3317"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#1B3317" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TÍTULO DEL HISTORIAL -->
            <TextView
                android:id="@+id/tvHistorialTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="Historial y Menús Anteriores"
                android:textColor="#1B3317"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/cardAccesoAsignadas"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- LISTA DE MENÚS ANTERIORES -->
            <LinearLayout
                android:id="@+id/layoutHistorialAnteriores"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvHistorialTitulo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- MENÚ ANTERIOR 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenuAnterior1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
