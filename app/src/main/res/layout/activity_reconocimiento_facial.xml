<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFacial"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17">

    <!-- BARRA SUPERIOR CON BOTÓN VOLVER Y CAMBIO DE CÁMARA -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopBarFacial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="44dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVolverFacial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnCambiarCamara"
            app:layout_constraintStart_toEndOf="@+id/btnVolverFacial"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtTituloFacial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Reconocimiento Facial"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtSubtituloFacial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="Escaneo Biométrico SIRAE"
                android:textColor="#F4B41F"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCambiarCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cambiar Cámara"
            android:padding="8dp"
            android:src="@drawable/ic_flip_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#CBD5E1" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENEDOR DEL VISOR DE CÁMARA CON BORDES REDONDEADOS Y SOMBRA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#000000"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutEstadoFacial"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTopBarFacial">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- VISTA DE CÁMARA (CameraX PreviewView) -->
            <androidx.camera.view.PreviewView
                android:id="@+id/previewViewFacial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter" />

            <!-- ÓVALO GUÍA DE ALINEACIÓN FACIAL -->
            <View
                android:id="@+id/viewOvalGuide"
                android:layout_width="220dp"
                android:layout_height="290dp"
                android:background="@drawable/bg_face_oval_guide"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- LÍNEA LÁSER ANIMADA DE ESCANEO -->
            <View
                android:id="@+id/viewLaserScan"
                android:layout_width="240dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_laser_line"
                android:visibility="invisible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/viewOvalGuide" />

            <!-- CORCHETE SUPERIOR IZQUIERDO -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- CORCHETE SUPERIOR DERECHO -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- CORCHETE INFERIOR IZQUIERDO -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- CORCHETE INFERIOR DERECHO -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_margin="18dp"
                android:background="#F4B41F"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- PÍLDORA DE ESTADO E INSTRUCCIÓN -->
    <LinearLayout
        android:id="@+id/layoutEstadoFacial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_status_pill"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btnCapturarFacial"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/progressFacial"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:indeterminateTint="#F4B41F"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtMensajeEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Ubica tu rostro dentro del óvalo"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- BOTÓN DE CAPTURA / ESCANEO CIRCULAR -->
    <FrameLayout
        android:id="@+id/btnCapturarFacial"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_circle_capture_btn"
        android:clickable="true"
        android:elevation="6dp"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="Capturar"
            android:src="@drawable/ic_reconocimiento_facial"
            app:tint="#181B1F" />
    </FrameLayout>

    <!-- ============================================================ -->
    <!-- OVERLAY DE ÉXITO / ACCESO AUTORIZADO (PASO 3)                -->
    <!-- ============================================================ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutExitoFacial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA0B0F17"
        android:clickable="true"
        android:focusable="true"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- FOTO CIRCULAR DEL ROSTRO VERIFICADO -->
            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFotoVerificada"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceCircular"
                    app:strokeColor="#10B981"
                    app:strokeWidth="4dp" />

                <!-- BADGE DE CHECK VERDE -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="#10B981"
                    android:contentDescription="Verificado"
                    android:padding="8dp"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="¡Acceso Autorizado!"
                android:textColor="#10B981"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtNombreVerificado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="¡Bienvenida, Manipuladora!"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtRolVerificado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#1A10B981"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text="ROL: MANIPULADORA"
                android:textColor="#34D399"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:text="Ingresando a tu panel de trabajo..."
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
