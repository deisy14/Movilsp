<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/layoutPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blanco"

    tools:context=".InicioJefaActivity">


    <!-- ===================================================== -->
    <!-- CONTENIDO PRINCIPAL                                   -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollInicio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contenedorInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/headerInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtSaludo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hola, Jefa"
                        android:textColor="@color/negro_principal"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Hoy es lunes, 29 de septiembre"
                        android:textColor="@color/gris_texto"
                        android:textSize="13sp"/>

                </LinearLayout>


                <!-- NOTIFICACIONES -->

                <ImageButton
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icono_circular"
                    android:contentDescription="Notificaciones"
                    android:padding="11dp"
                    android:src="@drawable/ic_notificaciones"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- TITULO                                             -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="MENÚ DIARIO"
                android:textAlignment="center"
                android:textColor="@color/negro_principal"
                android:textSize="20sp"
                android:textStyle="bold"/>


            <!-- ================================================= -->
            <!-- JORNADA                                            -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloJornada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="¿Qué jornada quieres consultar?"
                android:textAlignment="center"
                android:textColor="@color/gris_texto"
                android:textSize="13sp"/>

            <LinearLayout
                android:id="@+id/contenedorJornadas"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_jornada"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnManana"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_jornada_seleccionada"
                    android:gravity="center"
                    android:text="MAÑANA"
                    android:textColor="@color/blanco"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnTarde"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_jornada_no_seleccionada"
                    android:gravity="center"
                    android:text="TARDE"
                    android:textColor="@color/negro_principal"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SUGERENCIA DE IA                                  -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/seccionIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTituloIA"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sugerencia de la IA"
                        android:textColor="@color/negro_principal"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <ImageButton
                        android:id="@+id/btnInfoIA"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Información de IA"
                        android:padding="7dp"
                        android:src="@drawable/ic_info"
                        android:tint="@color/gris_texto"/>

                </LinearLayout>


                <TextView
                    android:id="@+id/txtSubtituloIA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Plato recomendado para la mañana"
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"/>


                <!-- TARJETA PLATO -->

                <LinearLayout
                    android:id="@+id/cardPlatoSugerido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_plato"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageButton
                        android:id="@+id/btnPlatoAnterior"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_flecha"
                        android:contentDescription="Plato anterior"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="@color/negro_principal"/>

                    <ImageView
                        android:id="@+id/imgPlatoSugerido"
                        android:layout_width="150dp"
                        android:layout_height="130dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Plato sugerido"
                        android:scaleType="centerCrop"
                        android:src="@drawable/pollo_guisado"/>

                    <ImageButton
                        android:id="@+id/btnPlatoSiguiente"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_flecha"
                        android:contentDescription="Plato siguiente"
                        android:padding="9dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="@color/negro_principal"/>

                </LinearLayout>


                <TextView
                    android:id="@+id/txtNombrePlato"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Pollo guisado"
                    android:textColor="@color/negro_principal"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtIndicadorPlatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="● ○ ○ ○"
                    android:textColor="@color/amarillo_principal"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_estado"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Pendiente"
                    android:textColor="@color/negro_principal"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnSeleccionarPlato"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_boton_amarillo"
                    android:gravity="center"
                    android:text="Seleccionar plato"
                    android:textColor="@color/blanco"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- RESUMEN DEL DÍA                                   -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Resumen del día"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:id="@+id/cardResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_resumen"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- NIÑOS -->

                <LinearLayout
                    android:id="@+id/filaNinos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_amarillo"
                        android:padding="9dp"
                        android:src="@drawable/ic_people"
                        android:contentDescription="Niños registrados"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Niños registrados"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txtNinos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="120 niños"
                            android:textColor="@color/negro_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:background="@color/gris_borde"/>


                <!-- PREPARACIONES -->

                <LinearLayout
                    android:id="@+id/filaPreparaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_verde"
                        android:padding="9dp"
                        android:src="@drawable/ic_food"
                        android:contentDescription="Preparaciones"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Preparaciones"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txtPreparaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="4 platos"
                            android:textColor="@color/negro_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:background="@color/gris_borde"/>


                <!-- ESTADO -->

                <LinearLayout
                    android:id="@+id/filaEstadoPreparacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_rojo"
                        android:padding="9dp"
                        android:src="@drawable/ic_status"
                        android:contentDescription="Estado del menú"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estado del menú"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/txtEstadoResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pendiente"
                            android:textColor="@color/rojo_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MIS PREPARACIONES                                 -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloMisPreparaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Mis preparaciones"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:id="@+id/cardMisPreparaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_resumen"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icono_verde"
                        android:padding="9dp"
                        android:src="@drawable/ic_food"
                        android:contentDescription="Mis preparaciones"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtMisPreparaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Arroz"
                            android:textColor="@color/negro_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtEstadoMisPreparaciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Pendiente de preparar"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="@color/negro_principal"
                        android:contentDescription="Ver preparaciones"/>

                </LinearLayout>


                <!-- PROGRESO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_jornada"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/progresoMisPreparaciones"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.35"
                        android:background="@drawable/bg_boton_amarillo"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.65"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CALENDARIO Y PROGRAMACIÓN                         -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Calendario y programación"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:id="@+id/cardCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_resumen"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icono_amarillo"
                        android:padding="9dp"
                        android:src="@drawable/ic_info"
                        android:contentDescription="Calendario"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtCalendario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calendario del menú"
                            android:textColor="@color/negro_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtProgramacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Consultar historial y programar la semana"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="@color/negro_principal"
                        android:contentDescription="Abrir calendario"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- EVOLUCIÓN DEL ALMUERZO                            -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloEvolucion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Evolución del almuerzo"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:id="@+id/cardEvolucionAlmuerzo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_resumen"
                android:orientation="vertical"
                android:padding="16dp">


                <!-- ENCABEZADO -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icono_verde"
                        android:padding="9dp"
                        android:src="@drawable/ic_status"
                        android:contentDescription="Evolución del almuerzo"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEstadoEvolucion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Preparación en curso"
                            android:textColor="@color/negro_principal"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/txtDetalleEvolucion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="2 de 4 preparaciones completadas"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- BARRA DE PROGRESO -->

                <LinearLayout
                    android:id="@+id/barraEvolucion"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_jornada"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/progresoEvolucion"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.50"
                        android:background="@drawable/bg_boton_amarillo"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.50"/>

                </LinearLayout>


                <!-- ESTADOS -->

                <LinearLayout
                    android:id="@+id/contenedorEstadosEvolucion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- PENDIENTES -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPendientesEvolucion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="@color/rojo_principal"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pendientes"
                            android:textColor="@color/gris_texto"
                            android:textSize="11sp"/>

                    </LinearLayout>


                    <!-- EN PREPARACIÓN -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEnPreparacionEvolucion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="@color/amarillo_principal"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="En preparación"
                            android:textColor="@color/gris_texto"
                            android:textSize="11sp"/>

                    </LinearLayout>


                    <!-- COMPLETADAS -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtCompletadasEvolucion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="@color/verde_prinpipal"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completadas"
                            android:textColor="@color/gris_texto"
                            android:textSize="11sp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- BOTÓN -->

                <TextView
                    android:id="@+id/btnVerEvolucion"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_boton_amarillo"
                    android:gravity="center"
                    android:text="Ver detalle del almuerzo"
                    android:textColor="@color/blanco"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INFORMACIÓN IA                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/infoIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_info"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:text="La sugerencia de IA tiene en cuenta la asistencia y los alimentos disponibles."
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"/>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/barra_navegacion_jefa"
        android:layout_width="match_parent"
        android:layout_height="88dp"/>

</LinearLayout>