<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutInicioJefa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.InicioJefaActivity">

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- FRANJA SUPERIOR AMARILLA (TOP CAP) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="#F5B81F" />

            <!-- TARJETA PRINCIPAL BLANCA CURVADA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/rounded_white_background"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="24dp">

                <!-- ENCABEZADO Y PERFIL PARA JEFA DE COCINA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSaludoJefa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hola, Jefa de Cocina"
                            android:textColor="#1B3317"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCargoHeaderJefa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Coordinación y Gestión PAE"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- NOTIFICACIONES -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnNotificacionesJefa"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Notificaciones"
                            android:src="@drawable/ic_notificaciones"
                            app:tint="#1B3317" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- PERFIL DE LA JEFA -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnPerfilHeader"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#F4B41F"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtInicialesJefa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="JF"
                            android:textColor="#1B3317"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- ENCABEZADO "MI SEMANA" -->
                <TextView
                    android:id="@+id/txtTituloMiSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi semana"
                    android:textColor="#1E293B"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRangoSemana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Menús programados · 26 – 30 de octubre"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- TIRA DE 5 DÍAS DE LA SEMANA (LUN - VIE) -->
                <LinearLayout
                    android:id="@+id/layoutTiraDiasSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- LUNES -->
                    <LinearLayout
                        android:id="@+id/btnDiaLun"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dia_semana_activo"
                        android:clickable="true"
                        android:elevation="2dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomDiaLun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lun"
                            android:textColor="#1E293B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNumDiaLun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="26"
                            android:textColor="#1E293B"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- MARTES -->
                    <LinearLayout
                        android:id="@+id/btnDiaMar"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dia_semana_inactivo"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomDiaMar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mar"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNumDiaMar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="27"
                            android:textColor="#1E293B"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- MIÉRCOLES -->
                    <LinearLayout
                        android:id="@+id/btnDiaMie"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dia_semana_inactivo"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomDiaMie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mié"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNumDiaMie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="28"
                            android:textColor="#1E293B"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- JUEVES -->
                    <LinearLayout
                        android:id="@+id/btnDiaJue"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dia_semana_inactivo"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomDiaJue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jue"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNumDiaJue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="29"
                            android:textColor="#1E293B"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- VIERNES -->
                    <LinearLayout
                        android:id="@+id/btnDiaVie"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_dia_semana_inactivo"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomDiaVie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vie"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNumDiaVie"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="30"
                            android:textColor="#1E293B"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- BANNER AMARILLO INTERACTIVO DE FECHA (LLEVA A PANTALLA 2) -->
                <LinearLayout
                    android:id="@+id/bannerCalendarioMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_banner_amarillo_borde"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:id="@+id/txtFechaSeleccionadaBanner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lun, 26 de octubre"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#D97706"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- TÍTULO SECCIÓN MENÚS ASIGNADOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Menús asignados a las manipuladoras"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- SCROLL HORIZONTAL DE TARJETAS DE MENÚS (DESAYUNO, ALMUERZO, MERIENDA) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- TARJETA 1: DESAYUNO -->
                        <LinearLayout
                            android:id="@+id/cardDesayuno"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_card_desayuno"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgDesayuno"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/plato1"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_chip_desayuno"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Desayuno"
                                android:textColor="#B45309"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtNombreDesayuno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Huevos pericos con arroz blanco"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Componente"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtComponenteDesayuno"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Refresco de avena, huevos pericos, arroz blanco"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- TARJETA 2: ALMUERZO -->
                        <LinearLayout
                            android:id="@+id/cardAlmuerzo"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_card_almuerzo"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgAlmuerzo"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/plato2"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_chip_almuerzo"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text=" Almuerzo"
                                android:textColor="#15803D"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtNombreAlmuerzo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Pollo en salsa blanca con pasta"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Componente"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtComponenteAlmuerzo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Jugo de fruta en leche, pollo en salsa blanca, pasta"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <!-- TARJETA 3: MERIENDA -->
                        <LinearLayout
                            android:id="@+id/cardMerienda"
                            android:layout_width="180dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_merienda"
                            android:clickable="true"
                            android:elevation="1dp"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgMerienda"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/plato3"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_chip_merienda"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Merienda"
                                android:textColor="#BE123C"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtNombreMerienda"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Chocolate en leche con arepa"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Componente"
                                android:textColor="#64748B"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/txtComponenteMerienda"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Chocolate en leche, arepa de maíz, banano"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- BANNER AMARILLO: "REGISTRA LA ASISTENCIA" -->
                <LinearLayout
                    android:id="@+id/bannerRegistraAsistencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_banner_amarillo_borde"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Registra la asistencia"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#D97706"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- SECCIÓN RESUMEN DEL DÍA -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResumenDia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F1F5F9"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Resumen del día"
                                    android:textColor="#1E293B"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtFechaResumenDia"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Mar, 20 de octubre"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="›"
                                android:textColor="#94A3B8"
                                android:textSize="20sp" />

                        </LinearLayout>

                        <!-- TRES MÉTRICAS CON DIVISORES -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- MÉTRICA 1: RACIONES TOTALES -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@drawable/circulo_amarillo_badge">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_nav_manipuladoras"
                                        app:tint="#1E293B" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/txtRacionesTotales"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="124"
                                    android:textColor="#1E293B"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Raciones totales"
                                    android:textColor="#64748B"
                                    android:textSize="10sp" />

                            </LinearLayout>

                            <!-- DIVISOR 1 -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="44dp"
                                android:background="#F1F5F9" />

                            <!-- MÉTRICA 2: MENÚS ACTIVOS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@drawable/bg_chip_almuerzo">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_check"
                                        app:tint="#15803D" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/txtMenusActivos"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="3"
                                    android:textColor="#1E293B"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Menús activos"
                                    android:textColor="#64748B"
                                    android:textSize="10sp" />

                            </LinearLayout>

                            <!-- DIVISOR 2 -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="44dp"
                                android:background="#F1F5F9" />

                            <!-- MÉTRICA 3: MANIPULADORAS -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <FrameLayout
                                    android:layout_width="38dp"
                                    android:layout_height="38dp"
                                    android:background="@drawable/bg_chip_desayuno">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_assignment_black"
                                        app:tint="#B45309" />
                                </FrameLayout>

                                <TextView
                                    android:id="@+id/txtCantManipuladoras"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="8"
                                    android:textColor="#1E293B"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Manipuladoras"
                                    android:textColor="#64748B"
                                    android:textSize="10sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA DE NAVEGACIÓN INFERIOR (PERMANECE INTACTA) -->
    <include
        android:id="@+id/barraNavegacionJefa"
        layout="@layout/barra_navegacion_jefa"
