<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.AsignarComponentesActivity">

    <!-- CONTENIDO CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- ENCABEZADO: REGRESAR, TÍTULO, INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_boton_volver_circular"
                    android:contentDescription="Regresar"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#1E293B" />

                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Asignar componentes"
                    android:textColor="#1E293B"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnInfo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_boton_volver_circular"
                    android:contentDescription="Información"
                    android:padding="9dp"
                    android:src="@drawable/ic_info"
                    app:tint="#1E293B" />

            </LinearLayout>

            <!-- BARRA DE FECHA CON ICONO DE SOL -->
            <LinearLayout
                android:id="@+id/bannerFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_badge_fecha"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Icono día"
                    android:src="@drawable/ic_sun"
                    app:tint="#F59E0B" />

                <TextView
                    android:id="@+id/txtFechaSeleccionada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Lunes, 26 de octubre"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SELECTOR DE SERVICIO: DESAYUNO / ALMUERZO / MERIENDA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_resumen"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnTabDesayuno"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#F4B41F"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Desayuno"
                    android:textAllCaps="false"
                    android:textColor="#1B3317"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:elevation="0dp" />

                <Button
                    android:id="@+id/btnTabAlmuerzo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/transparent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Almuerzo"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:elevation="0dp" />

                <Button
                    android:id="@+id/btnTabMerienda"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@android:color/transparent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Merienda"
                    android:textAllCaps="false"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:elevation="0dp" />

            </LinearLayout>

            <!-- TARJETA DE ASISTENCIA (PORCIONES Y ESTUDIANTES) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icono_circular">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Asistencia"
                            android:src="@drawable/ic_people"
                            app:tint="#64748B" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtTituloAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Asistencia - Primaria"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSubtituloAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="84 porciones para el desayuno"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNumeroAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="84"
                            android:textColor="#1E293B"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtEtiquetaAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="niños"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA DEL PLATO DEL DÍA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgPlato"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Plato del servicio"
                            android:scaleType="centerCrop"
                            android:src="@drawable/plato1" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtCategoriaPlato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DESAYUNO DEL DÍA"
                            android:textColor="#166534"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNombrePlato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Huevos revueltos, pan y fruta"
                            android:textColor="#1E293B"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtDescripcionPlato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Un inicio de día nutritivo para nuestros estudiantes."
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA PLEGABLE DE RECETA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReceta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFDF5"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#FDE68A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Receta"
                            android:src="@drawable/ic_book"
                            app:tint="#1E293B" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Receta"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtToggleReceta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▲"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtInstruccionesReceta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Cocinar los ingredientes a fuego suave hasta que estén bien cocidos y servir caliente según las porciones establecidas por el programa PAE."
                        android:textColor="#475569"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ENCABEZADO DE COMPONENTES CON BADGE DE PROGRESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTituloComponentes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Componentes del desayuno"
                    android:textColor="#1E293B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBadgeProgreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_progreso"
                    android:text="✓ 0 de 3"
                    android:textColor="#047857"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Elige quién preparará cada componente."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- CONTENEDOR DINÁMICO DE COMPONENTES -->
            <LinearLayout
                android:id="@+id/layoutListaComponentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- BOTÓN GUARDAR ASIGNACIÓN -->
            <Button
                android:id="@+id/btnGuardarAsignacion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F4B41F"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✓ Guardar asignación"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA DE NAVEGACIÓN INFERIOR DE LA JEFA -->
    <include
        android:id="@+id/barraNavegacionJefa"
        layout="@layout/barra_navegacion_jefa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>

