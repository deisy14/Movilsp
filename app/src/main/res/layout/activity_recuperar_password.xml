<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRecuperar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181D24"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.auth.RecuperarPasswordActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- BOTÓN REGRESAR -->
        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Regresar"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#CBD5E1" />

        <!-- TÍTULO DE LA PANTALLA -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Recuperar contraseña"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/btnRegresar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnRegresar"
            app:layout_constraintTop_toTopOf="@+id/btnRegresar" />

        <!-- ICONO DE CANDADO CIRCULAR -->
        <FrameLayout
            android:id="@+id/layoutIcono"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/circulo_amarillo"
            android:backgroundTint="#2D3B2C"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnRegresar">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_outline"
                app:tint="#EAA32B" />
        </FrameLayout>

        <!-- DESCRIPCIÓN EXPLICATIVA -->
        <TextView
            android:id="@+id/txtDescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Ingresa el correo electrónico asociado a tu cuenta SIRAE para recibir un código de verificación de 6 dígitos."
            android:textColor="#CBD5E1"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutIcono" />

        <!-- ============================================== -->
        <!-- PASO 1: SOLICITAR CÓDIGO (CORREO)              -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutPaso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/txtDescripcion">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Correo electrónico registrado"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Correo"
                    android:src="@drawable/ic_email_outline"
                    app:tint="#CBD5E1" />

                <EditText
                    android:id="@+id/txtCorreoRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="ejemplo@sirae.com"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarCodigo"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#EAA32B"
                android:text="Enviar código al correo"
                android:textAllCaps="false"
                android:textColor="#181B1F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="#181B1F"
                app:rippleColor="#30000000" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- PASO 2: INGRESAR CÓDIGO Y NUEVA CONTRASEÑA    -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutPaso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/layoutPaso1"
            tools:visibility="visible">

            <!-- BANNER INFORMATIVO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_input_pill"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtAvisoEnvio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¡Código enviado! Revisa tu bandeja de entrada o spam."
                    android:textColor="#EAA32B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCorreoEnviado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="#CBD5E1"
                    android:textSize="12.5sp"
                    tools:text="usuario@sirae.com" />
            </LinearLayout>

            <!-- CÓDIGO DE 6 DÍGITOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="Código de verificación (6 dígitos)"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Código"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#CBD5E1" />

                <EditText
                    android:id="@+id/txtCodigoVerificacion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="123456"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:letterSpacing="0.2"
                    android:maxLength="6"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- NUEVA CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="Nueva contraseña"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Contraseña"
                    android:src="@drawable/ic_lock_outline"
                    app:tint="#CBD5E1" />

                <EditText
                    android:id="@+id/txtNuevaPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Mínimo 6 u 8 caracteres"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14.5sp" />

                <ImageView
                    android:id="@+id/btnToggleNuevaPassword"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Ver contraseña"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_visibility_off_white"
                    app:tint="#CBD5E1" />
            </LinearLayout>

            <!-- CONFIRMAR CONTRASEÑA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="Confirmar nueva contraseña"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_input_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Confirmar Contraseña"
                    android:src="@drawable/ic_lock_outline"
                    app:tint="#CBD5E1" />

                <EditText
                    android:id="@+id/txtConfirmarPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Repite la contraseña"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14.5sp" />

                <ImageView
                    android:id="@+id/btnToggleConfirmarPassword"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Ver contraseña"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_visibility_off_white"
                    app:tint="#CBD5E1" />
            </LinearLayout>

            <!-- BOTÓN RESTABLECER -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestablecer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#EAA32B"
                android:text="Restablecer contraseña"
                android:textAllCaps="false"
                android:textColor="#181B1F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="27dp"
                app:rippleColor="#30000000" />

            <!-- REENVIAR CÓDIGO -->
            <TextView
                android:id="@+id/btnReenviarCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="¿No recibiste el código? Reenviar"
                android:textColor="#EAA32B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
