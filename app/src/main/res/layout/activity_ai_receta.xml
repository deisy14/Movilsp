<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnVolver"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="19dp"
            app:cardElevation="1dp"
            app:strokeColor="#F1F5F9"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="‹"
                android:textColor="#1E293B"
                android:textSize="24sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Asistente IA - Recetas PAE &amp; Bodega"
            android:textColor="#1E293B"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CONTENIDO CON SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA INTRODUCCIÓN IA -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FEF3C7"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#FCD34D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 Sugerencias Inteligentes con Inventario"
                        android:textColor="#92400E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Genera recetas coherentes con el ciclo PAE y la jornada (Desayuno, Almuerzo o Merienda), calcula las cantidades para los niños y proyecta la disminución del stock en bodega."
                        android:textColor="#78350F"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- PANEL DE PARÁMETROS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- SELECCIÓN DE MOMENTO -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Momento de Entrega"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMomentoDesayuno"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Desayuno"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMomentoAlmuerzo"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Almuerzo"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMomentoMerienda"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Merienda"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp" />

                    </LinearLayout>

                    <!-- CANTIDAD DE NIÑOS / RACIONES -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Número de Niños / Raciones"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etNinosPresentes"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_banner_amarillo_borde"
                        android:digits="0123456789"
                        android:hint="Ej: 200"
                        android:inputType="number"
                        android:paddingHorizontal="12dp"
                        android:text="200"
                        android:textColor="#1E293B"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- BOTÓN GENERAR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerarIA"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="#F4B41F"
                        android:text="⚡ Generar Sugerencia con IA"
                        android:textAllCaps="false"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- LOADING INDICATOR -->
            <LinearLayout
                android:id="@+id/layoutCargandoIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminateTint="#F4B41F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Consultando IA y calculando gramajes de bodega..."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- RESULTADO SUGERENCIA IA -->
            <LinearLayout
                android:id="@+id/layoutResultadoIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- TARJETA DEL PLATO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvChipMomento"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_desayuno"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Desayuno • Coherencia PAE"
                                android:textColor="#B45309"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvBadgeStock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Stock Disponible"
                                android:textColor="#15803D"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNombrePlatoIA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Huevos Pericos con Arepa, Queso y Chocolate"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvComponentesIA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bebida con leche, Alimento proteico, Cereal acompañante, Fruta"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- TARJETA INGREDIENTES PARA 200 NIÑOS Y DESCUENTO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvTituloIngredientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ingredientes &amp; Disminución de Inventario (200 Niños)"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Gramajes oficiales por porción escolar y total a preparar"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <!-- CONTENEDOR DINÁMICO DE FILAS DE INGREDIENTES -->
                        <LinearLayout
                            android:id="@+id/layoutListaIngredientes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- BOTÓN CONFIRMAR Y DESCONTAR -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmarDescuento"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="#15803D"
                    android:text="✓ Confirmar Menú y Descontar de Bodega"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

            </LinearLayout>

            <!-- BOTÓN REDACTAR RECETA MANUAL -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIrARedactar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:text="Redactar Otra Receta Manualmente"
                android:textAllCaps="false"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#CBD5E1" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
