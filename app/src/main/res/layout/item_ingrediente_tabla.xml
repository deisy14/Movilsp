<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- FILA SUPERIOR: NOMBRE, BADGE BASE Y PASTILLA DE CANTIDAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNombreIngrediente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Huevo fresco AA"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- ETIQUETA "Base" -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_green"
                    android:backgroundTint="#F1F5F9"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="Base"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PASTILLA DE CANTIDAD -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCantidadIngrediente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="9.7 kg"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleGramaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="end"
                    android:text="P: 55g · S: 65g"
                    android:textColor="#64748B"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- FILA MEDIA: MARCA -->
        <TextView
            android:id="@+id/tvMarcaIngrediente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Marca: Avícola Cauca"
            android:textColor="#92400E"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- FILA INFERIOR: DESCRIPCIÓN / FUNCIÓN DE SABOR -->
        <TextView
            android:id="@+id/tvDescripcionIngrediente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Base proteica y textura cremosa"
            android:textColor="#64748B"
            android:textSize="11.5sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
