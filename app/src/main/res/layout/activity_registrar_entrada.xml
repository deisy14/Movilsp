<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF7">

    <ScrollView
        android:id="@+id/scrollRegistrarEntrada"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="110dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- ================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVolver"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_arrow_back"
                    android:contentDescription="Volver"
                    android:tint="#3F3B28"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="SIRAE"
                    android:textColor="#5F7435"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

            </LinearLayout>


            <!-- ================================= -->
            <!-- TÍTULO -->
            <!-- ================================= -->

            <!-- ================================= -->
            <!-- TÍTULO -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Recepción de Insumos"
                android:textColor="#3F3F3A"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Verifica y chulea el cargamento entregado por el supervisor cada 20 días."
                android:textColor="#686862"
                android:textSize="13sp"/>


            <!-- ================================= -->
            <!-- TARJETA FORMULARIO -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- INGREDIENTE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Insumo o ingrediente entregado"
                    android:textColor="#3F3F3A"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spnIngrediente"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_busqueda"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <!-- INFORMACIÓN DE CANTIDAD ENVIADA -->
                <TextView
                    android:id="@+id/txtCantidadEsperada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📦 Cantidad programada: 50 lb"
                    android:textColor="#176B35"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- CHULEAR: ¿LLEGÓ COMPLETO? -->
                <CheckBox
                    android:id="@+id/chkLlegoCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:checked="true"
                    android:text="✓ Llegó completo tal cual lo enviado"
                    android:textColor="#1D2939"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- SECCIÓN FALTANTE (SI NO LLEGA COMPLETO) -->
                <LinearLayout
                    android:id="@+id/layoutAjusteFaltante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cantidad que realmente llegó"
                        android:textColor="#B42318"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtCantidadReal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_busqueda"
                        android:hint="Ej. 45"
                        android:inputType="numberDecimal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#3F3F3A"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Reporte de faltante o novedad"
                        android:textColor="#3F3F3A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtNovedadFaltante"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_busqueda"
                        android:gravity="top|start"
                        android:hint="Ej. Faltaron 5 libras por empaque roto en transporte"
                        android:padding="12dp"
                        android:textColor="#3F3F3A"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================= -->
            <!-- INFORMACIÓN -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_aprobado"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="#49612D"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Al confirmar, se actualizará el stock verificado en el sistema PAE institucional."
                    android:textColor="#34443A"
                    android:textSize="12sp"/>

            </LinearLayout>


            <!-- ================================= -->
            <!-- GUARDAR -->
            <!-- ================================= -->

            <Button
                android:id="@+id/btnGuardarEntrada"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#FFD928"
                android:text="Confirmar recepción de insumos  ›"
                android:textAllCaps="false"
                android:textColor="#3D3A20"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"/>


            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"/>

        </LinearLayout>

    </ScrollView>


    <!-- ================================= -->
    <!-- BARRA DE NAVEGACIÓN -->
    <!-- ================================= -->

    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>