<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    tools:context=".ui.manipuladora.PerfilActivity">

    <!-- ========================================= -->
    <!-- CONTENIDO DESPLAZABLE                     -->
    <!-- ========================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contenedorPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- TARJETA CABECERA DE USUARIO / AVATAR CON FOTO -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/btnCambiarFotoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgFotoPerfil"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_gravity="center"
                                android:background="#F8FAFC"
                                android:padding="18dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_nav_perfil"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                                app:strokeColor="#CBD5E1"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="bottom|end"
                                app:cardBackgroundColor="#F4B41F"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="4dp"
                                app:strokeColor="#FFFFFF"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Cambiar foto"
                                    android:src="@drawable/ic_editar"
                                    app:tint="#1B3317" />
                            </com.google.android.material.card.MaterialCardView>

                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtNombreUsuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="María José Rojas"
                            android:textColor="#1E293B"
                            android:textSize="21sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtCargoUsuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:text="Manipuladora de Alimentos · Sede Institucional"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtEstadoUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_pill_green"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="● Activo en Turno"
                        android:textColor="#2A5226"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD TURNO ACTUAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTurnoActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FAF9F4"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtEtiquetaTurno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TURNO ASIGNADO HOY"
                        android:textColor="#7A5500"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHorarioTurno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Turno Mañana · 6:00 a. m. - 2:00 p. m."
                        android:textColor="#1B3317"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- OPCIONES DE CUENTA -->
            <TextView
                android:id="@+id/txtTituloCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Opciones de la Cuenta"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- EDITAR PERFIL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnEditarPerfilCard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/icEditarPerfil"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_circular"
                        android:backgroundTint="#FFFBEB"
                        android:contentDescription="Editar perfil"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1E293B" />

                    <TextView
                        android:id="@+id/txtEditarPerfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Editar perfil"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#64748B" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NOTIFICACIONES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNotificacionesCard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/icNotificaciones"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_circular"
                        android:backgroundTint="#FFFBEB"
                        android:contentDescription="Notificaciones"
                        android:padding="9dp"
                        android:src="@drawable/ic_notificaciones"
                        app:tint="#1E293B" />

                    <TextView
                        android:id="@+id/txtNotificaciones"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Avisos y Notificaciones"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#64748B" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AYUDA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAyudaCard"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#F4B41F"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:id="@+id/btnAyuda"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/icAyuda"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_icono_circular"
                        android:backgroundTint="#FFFBEB"
                        android:contentDescription="Ayuda"
                        android:padding="9dp"
                        android:src="@drawable/ic_help"
                        app:tint="#1E293B" />

                    <TextView
                        android:id="@+id/txtAyuda"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Ayuda y soporte institucional"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#64748B" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CERRAR SESIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#F4B41F"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="2dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA DE NAVEGACIÓN -->
    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>