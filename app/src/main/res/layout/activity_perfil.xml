<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    tools:context=".ui.manipuladora.PerfilActivity">

    <!-- ========================================= -->
    <!-- CONTENIDO DESPLAZABLE                     -->
    <!-- ========================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/contenedorPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- ENCABEZADO Y TÍTULO -->
            <TextView
                android:id="@+id/txtTituloPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MI PERFIL"
                android:textColor="#1B3317"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Información personal y ajustes de la cuenta"
                android:textColor="#3D5C37"
                android:textSize="12sp" />

            <!-- TARJETA CABECERA DE USUARIO / AVATAR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInfoUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/contenedorAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtAvatar"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:gravity="center"
                        android:text="MJ"
                        android:textColor="#7A5500"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNombreUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="María José Rojas"
                        android:textColor="#1B3317"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCargoUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Manipuladora de Alimentos · Sede Institucional"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtEstadoUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_pill_green"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="● Activo en Turno"
                        android:textColor="#2A5226"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD TURNO ACTUAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTurnoActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#FAF9F4"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#EBE8D8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtEtiquetaTurno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TURNO ASIGNADO HOY"
                        android:textColor="#7A5500"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHorarioTurno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Turno Mañana · 6:00 a. m. - 2:00 p. m."
                        android:textColor="#1B3317"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- OPCIONES DE CUENTA -->
            <TextView
                android:id="@+id/txtTituloCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Opciones de la Cuenta"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- EDITAR PERFIL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnEditarPerfilCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/btnEditarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icEditarPerfil"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Editar perfil"
                        android:src="@drawable/ic_person_edit"
                        app:tint="#1B3317" />

                    <TextView
                        android:id="@+id/txtEditarPerfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Editar perfil"
                        android:textColor="#1B3317"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#1B3317" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NOTIFICACIONES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNotificacionesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icNotificaciones"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Notificaciones"
                        android:src="@drawable/ic_notificaciones"
                        app:tint="#1B3317" />

                    <TextView
                        android:id="@+id/txtNotificaciones"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Avisos y Notificaciones"
                        android:textColor="#1B3317"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#1B3317" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- AYUDA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAyudaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/btnAyuda"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/icAyuda"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Ayuda"
                        android:src="@drawable/ic_help"
                        app:tint="#1B3317" />

                    <TextView
                        android:id="@+id/txtAyuda"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Ayuda y soporte institucional"
                        android:textColor="#1B3317"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Ir"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#1B3317" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CERRAR SESIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#F2BF15"
                android:text="Cerrar sesión"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BARRA DE NAVEGACIÓN -->
    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>