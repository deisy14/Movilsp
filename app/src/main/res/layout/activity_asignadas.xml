<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4B41F"
    tools:context=".ui.manipuladora.AsignadasActivity">

    <!-- ===================================================== -->
    <!-- ENCABEZADO                                             -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutHeaderAsignadas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="52dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTituloAsignadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASIGNADAS"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaAsignadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="LUNES / 7 / JUN / 2026"
            android:textColor="#222222"
            android:textSize="13sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENEDOR BLANCO                                     -->
    <!-- ===================================================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorAsignadas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/fondo_blanco_superior"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutHeaderAsignadas">


        <!-- ================================================= -->
        <!-- TITULO                                             -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvSubtituloAsignadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manipuladoras asignadas"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvInfoAsignadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Selecciona una manipuladora para ver su asignación."
            android:textColor="#667085"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtituloAsignadas" />


        <!-- ================================================= -->
        <!-- SCROLL DE MANIPULADORAS                            -->
        <!-- ================================================= -->

        <ScrollView
            android:id="@+id/scrollAsignadas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvInfoAsignadas">

            <LinearLayout
                android:id="@+id/contenedorManipuladoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <!-- ================================================= -->
                <!-- FILA 1                                             -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- SOFIA -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManipuladora1"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="3dp"
                                app:strokeColor="#E7B84A"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgManipuladora1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de Sofía"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreManipuladora1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Manipuladora: Sofía"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlatoManipuladora1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="#596B35"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Ensaladas"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoManipuladora1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Preferencia del cliente"
                                android:textColor="#333333"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/progresoManipuladora1"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="65" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- DIEGO -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManipuladora2"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="50dp"
                                app:cardElevation="3dp"
                                app:strokeColor="#E7B84A"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgManipuladora2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de Diego"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreManipuladora2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Manipularora: Daniela"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlatoManipuladora2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="#B7DDE5"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Ceviche"
                                android:textColor="#111111"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoManipuladora2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Ingredientes listos"
                                android:textColor="#333333"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/progresoManipuladora2"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="80" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- FILA 2                                             -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- ELENA -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManipuladora3"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="50dp"
                                app:strokeColor="#E7B84A"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgManipuladora3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de Elena"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreManipuladora3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Manupuladora: Elena"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlatoManipuladora3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="#F6D5C5"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Postres"
                                android:textColor="#111111"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoManipuladora3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Ingredientes listos"
                                android:textColor="#333333"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/progresoManipuladora3"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="45" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- MARA -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManipuladora4"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="50dp"
                                app:strokeColor="#E7B84A"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgManipuladora4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de Mara"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreManipuladora4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Manipuladora: Mara"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlatoManipuladora4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="#C9A36A"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Asados"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoManipuladora4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Ingredientes listos"
                                android:textColor="#333333"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/progresoManipuladora4"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="60" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- FILA 3                                             -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- RIARO -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManipuladora5"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="50dp"
                                app:strokeColor="#E7B84A"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgManipuladora5"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de Riaro"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreManipuladora5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Manipuladora:Vanesa"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlatoManipuladora5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="#596B35"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Principal"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoManipuladora5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="En preparación"
                                android:textColor="#333333"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/progresoManipuladora5"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="30" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- BORON -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardManipuladora6"
                        android:layout_width="0dp"
                        android:layout_height="230dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#E7B84A"
                        app:strokeWidth="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                app:cardCornerRadius="50dp"
                                app:strokeColor="#E7B84A"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/imgManipuladora6"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="Foto de Boron"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_person" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvNombreManipuladora6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Manipuladora: Dayana"
                                android:textColor="#111111"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPlatoManipuladora6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="#E7B84A"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="Principal"
                                android:textColor="#111111"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEstadoManipuladora6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Ingredientes listos"
                                android:textColor="#333333"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/progresoManipuladora6"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:max="100"
                                android:progress="90" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ===================================================== -->
    <!-- BARRA DE NAVEGACIÓN                                   -->
    <!-- ===================================================== -->

    <include
        android:id="@+id/barra_navegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>