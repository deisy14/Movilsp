<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F3"
    tools:context=".ui.manipuladora.TurnoActivity">

    <!-- ===================================================== -->
    <!-- FONDO                                                  -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_sirae"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================== -->
    <!-- CAPA TRANSPARENTE                                     -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/capaFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================== -->
    <!-- CONTENIDO                                              -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollTurno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- ================================================= -->
            <!-- TARJETA PRINCIPAL                                 -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardTurno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="26dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="26dp"
                    android:paddingBottom="30dp">

                    <!-- ========================================= -->
                    <!-- LOGO                                      -->
                    <!-- ========================================= -->

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="150dp"
                        android:layout_height="70dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Logo SIRAE"
                        android:scaleType="centerInside"
                        android:src="@drawable/logo_sirae" />

                    <!-- ========================================= -->
                    <!-- ICONO                                     -->
                    <!-- ========================================= -->

                    <!-- ========================================= -->
                    <!-- TITULO                                    -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/txtTituloTurno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Iniciando tu turno"
                        android:textColor="#202020"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- ========================================= -->
                    <!-- SUBTITULO                                  -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/txtSubtituloTurno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center"
                        android:text="Tu plato asignado es:"
                        android:textColor="#707070"
                        android:textSize="14sp" />

                    <!-- ========================================= -->
                    <!-- PLATO                                      -->
                    <!-- ========================================= -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPlato"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#FFF4C7"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp">

                            <TextView
                                android:id="@+id/txtPlatoAsignado"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:text="Pollo guisado"
                                android:textColor="#202020"
                                android:gravity="center"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- ========================================= -->
                    <!-- MENSAJE                                   -->
                    <!-- ========================================= -->

                    <TextView
                        android:id="@+id/txtMensajeTurno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Preparando la información de tu turno..."
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>