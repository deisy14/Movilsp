<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blanco">

    <!-- ================================================= -->
    <!-- ENCABEZADO                                       -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnCerrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icono_circular"
            android:contentDescription="Volver"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/negro_principal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial"
                android:textColor="@color/negro_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Preparaciones realizadas"
                android:textColor="@color/gris_texto"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- FILTROS                                          -->
    <!-- ================================================= -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTodas"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:backgroundTint="@color/amarillo_principal"
                android:text="Todas"
                android:textColor="@color/blanco"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnManana"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/gris_claro"
                android:text="Mañana"
                android:textColor="@color/negro_principal"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTarde"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/gris_claro"
                android:text="Tarde"
                android:textColor="@color/negro_principal"
                android:textSize="13sp" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ================================================= -->
    <!-- CONTENEDOR DE HISTORIAL                          -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenedorHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="24dp">


            <!-- ================================================= -->
            <!-- REGISTRO 1                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardPreparacion1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_resumen"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtFecha1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoy"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtPlato1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Arroz con pollo"
                            android:textColor="@color/negro_principal"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtEstado1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_icono_verde"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="Completada"
                        android:textColor="@color/negro_principal"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/gris_claro" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtJornada1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mañana"
                        android:textColor="@color/gris_texto"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtNinos1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="35 niños"
                        android:textColor="@color/negro_principal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnVer1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/amarillo_principal"
                    android:text="Ver detalle"
                    android:textColor="@color/negro_principal"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- REGISTRO 2                                       -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardPreparacion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_resumen"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtFecha2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ayer"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtPlato2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Lentejas con arroz"
                            android:textColor="@color/negro_principal"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtEstado2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_icono_verde"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="Completada"
                        android:textColor="@color/negro_principal"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/gris_claro" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/txtJornada2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tarde"
                        android:textColor="@color/gris_texto"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtNinos2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28 niños"
                        android:textColor="@color/negro_principal"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnVer2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/amarillo_principal"
                    android:text="Ver detalle"
                    android:textColor="@color/negro_principal"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SIN REGISTROS                                   -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/contenedorVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="40dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgHistorialVacio"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_icono_amarillo"
                    android:padding="14dp"
                    android:src="@drawable/ic_nav_preparaciones"
                    android:tint="@color/negro_principal"
                    android:contentDescription="Sin preparaciones" />

                <TextView
                    android:id="@+id/txtHistorialVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="Todavía no hay preparaciones registradas."
                    android:textColor="@color/gris_texto"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>