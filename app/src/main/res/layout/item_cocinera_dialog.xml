<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_resumen">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icono_amarillo"
        android:contentDescription="Cocinera"
        android:padding="8dp"
        android:src="@drawable/ic_nav_manipuladoras" />

    <TextView
        android:id="@+id/txtNombreCocineraItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="Nombre Cocinera"
        android:textColor="#1E293B"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
