<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".LoginJefaActivity">


    <!-- ===================================================== -->
    <!-- FONDO                                                  -->
    <!-- ===================================================== -->

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_sirae"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- CAPA TRANSPARENTE                                     -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/capaFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#18FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- TARJETA LOGIN                                          -->
    <!-- ===================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">


            <!-- ============================================= -->
            <!-- LOGO                                          -->
            <!-- ============================================= -->

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="135dp"
                android:layout_height="58dp"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_sirae"
                android:scaleType="centerInside"
                android:contentDescription="Logo SIRAE" />


            <!-- ============================================= -->
            <!-- TITULO                                        -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:text="Iniciar sesión"
                android:textColor="#202020"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- ============================================= -->
            <!-- SUBTITULO                                     -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="Ingresa tus datos para continuar"
                android:textColor="#777777"
                android:textSize="11sp" />


            <!-- ============================================= -->
            <!-- CORREO                                        -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/lblCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Correo electrónico"
                android:textColor="#303030"
                android:textSize="12sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/txtCorreo"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:hint="ejemplo@correo.com"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:importantForAutofill="yes"
                android:autofillHints="emailAddress"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#222222"
                android:textColorHint="#999999"
                android:textSize="13sp" />


            <!-- ============================================= -->
            <!-- CONTRASEÑA                                    -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/lblPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Contraseña"
                android:textColor="#303030"
                android:textSize="12sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/txtPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:hint="Ingresa tu contraseña"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:importantForAutofill="yes"
                android:autofillHints="password"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#222222"
                android:textColorHint="#999999"
                android:textSize="13sp" />


            <!-- ============================================= -->
            <!-- OLVIDASTE CONTRASEÑA                          -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtOlvide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="¿Olvidaste tu contraseña?"
                android:textColor="@color/verde_prinpipal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />


            <!-- ============================================= -->
            <!-- BOTON INGRESAR                                -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_boton_amarillo"
                android:gravity="center"
                android:text="Ingresar"
                android:textColor="@color/negro_principal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:elevation="3dp" />


            <!-- ============================================= -->
            <!-- SEPARADOR                                     -->
            <!-- ============================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="#EEEEEE" />


            <!-- ============================================= -->
            <!-- NO TIENES CUENTA                              -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtNoCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="¿No tienes cuenta?"
                android:textColor="#999999"
                android:textSize="11sp" />


            <!-- ============================================= -->
            <!-- ADMINISTRADOR                                 -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtAdministrador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Contacta al administrador"
                android:textColor="@color/verde_prinpipal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
