<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- ENCABEZADO                                       -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnCerrar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_circular"
                android:contentDescription="Volver"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/negro_principal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalle de preparación"
                    android:textColor="@color/negro_principal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hoy"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ESTADO                                           -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/cardEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_resumen"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgEstado"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icono_verde"
                android:contentDescription="Estado"
                android:padding="10dp"
                android:src="@drawable/ic_check"
                android:tint="@color/negro_principal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado"
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Completada"
                    android:textColor="@color/negro_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- INFORMACIÓN GENERAL                              -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Información general"
            android:textColor="@color/negro_principal"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- MENÚ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_resumen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menú preparado"
                android:textColor="@color/gris_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Arroz con pollo"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- JORNADA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_resumen"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jornada"
                android:textColor="@color/gris_texto"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtJornada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mañana"
                android:textColor="@color/negro_principal"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- NIÑOS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_resumen"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Niños atendidos"
                android:textColor="@color/gris_texto"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNinos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35 niños"
                android:textColor="@color/negro_principal"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- MANIPULADORAS                                    -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Manipuladoras"
            android:textColor="@color/negro_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorManipuladoras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_resumen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtManipuladoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ana López&#10;María Rodríguez"
                android:textColor="@color/negro_principal"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ALIMENTOS                                        -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Alimentos utilizados"
            android:textColor="@color/negro_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorAlimentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_resumen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtAlimentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arroz     12 kg&#10;Pollo     18 kg&#10;Verduras   8 kg"
                android:textColor="@color/negro_principal"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- TIEMPOS                                          -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Tiempos"
            android:textColor="@color/negro_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_resumen"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Inicio"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtHoraInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:15 a. m."
                    android:textColor="@color/negro_principal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/gris_claro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Finalización"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtHoraFin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:05 a. m."
                    android:textColor="@color/negro_principal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/gris_claro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Duración"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtDuracion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50 minutos"
                    android:textColor="@color/negro_principal"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- OBSERVACIONES                                    -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Observaciones"
            android:textColor="@color/negro_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_resumen"
            android:padding="16dp"
            android:text="Sin observaciones"
            android:textColor="@color/gris_texto"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- BOTÓN                                             -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/amarillo_principal"
            android:text="Volver al historial"
            android:textColor="@color/blanco"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>