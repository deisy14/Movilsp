<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- CABECERA DE LA ASIGNACIÓN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAsignacionTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="ASIGNACIÓN PAE"
                    android:textColor="#1B3317"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstadoAsignacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_yellow"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Asignado"
                    android:textColor="#7A5500"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#E2E8F0" />

            <!-- AVATAR Y NOMBRE DEL PLATO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:cardBackgroundColor="#FEF9E7"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#F4B41F"
                    app:strokeWidth="1.5dp">

                    <ImageView
                        android:id="@+id/imgManipuladoraDetalle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="Manipuladora"
                        android:src="@drawable/ic_person"
                        app:tint="#1B3317" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvNombrePlatoAsignacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Pollo Guisado Criollo"
                    android:textColor="#1B3317"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SECCIÓN: PASOS DE PREPARACIÓN -->
            <TextView
                android:id="@+id/tvTituloPreparacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Pasos de Preparación"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tag_plato"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvPaso1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Recepción y desinfección de materia prima"
                    android:textColor="#1B3317"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="2. Pesado y verificación de insumos"
                    android:textColor="#1B3317"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPaso3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="3. Servido y control de gramaje escolar"
                    android:textColor="#1B3317"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- SECCIÓN: INGREDIENTES -->
            <TextView
                android:id="@+id/tvTituloIngredientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ingredientes Requeridos"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIngredientesAsignacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tag_plato"
                android:padding="12dp"
                android:text="• Pollo fresco (18 kg)\n• Verduras y Guiso (8 kg)\n• Sazón y Sal Yodada (2 kg)"
                android:textColor="#1B3317"
                android:textSize="12sp" />

            <!-- BOTONES DE ACCIÓN -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarcarCompletado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F4B41F"
                android:text="Marcar como completado"
                android:textColor="#1B3317"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarDetalle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="Cerrar"
                android:textColor="#64748B"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#CBD5E1" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.core.widget.NestedScrollView>