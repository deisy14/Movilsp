<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF7">

    <!-- ========================================= -->
    <!-- CONTENIDO -->
    <!-- ========================================= -->

    <ScrollView
        android:id="@+id/scrollEditarPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="22dp"
            android:paddingBottom="25dp">

            <!-- ================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/txtSirae"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="SIRAE"
                android:textColor="#477A26"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Editar perfil"
                android:textColor="#30302C"
                android:textSize="27sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Actualiza tu información personal."
                android:textColor="#686862"
                android:textSize="14sp"/>


            <!-- ================================= -->
            <!-- AVATAR -->
            <!-- ================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtAvatar"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="MJ"
                    android:textColor="#3F3F3A"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Foto de perfil"
                    android:textColor="#77776F"
                    android:textSize="13sp"/>

            </LinearLayout>


            <!-- NOTA INSTITUCIONAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_aprobado"
                android:padding="12dp"
                android:text="🔒 Nombre, documento y correo son asignados por el Administrador del PAE y no pueden modificarse. Solo puedes actualizar tu contraseña de acceso y teléfono."
                android:textColor="#176B35"
                android:textSize="12sp" />

            <!-- ================================= -->
            <!-- NOMBRE -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Nombre completo (Solo lectura)"
                android:textColor="#3F3F3A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:enabled="false"
                android:focusable="false"
                android:hint="Nombre completo"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#77776F"
                android:textSize="14sp"/>


            <!-- ================================= -->
            <!-- CORREO -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Correo institucional (Solo lectura)"
                android:textColor="#3F3F3A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtCorreo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:enabled="false"
                android:focusable="false"
                android:hint="Correo institucional"
                android:inputType="textEmailAddress"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#77776F"
                android:textSize="14sp"/>


            <!-- ================================= -->
            <!-- TELÉFONO -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Teléfono de contacto"
                android:textColor="#3F3F3A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtTelefono"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Número de teléfono"
                android:inputType="phone"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:text="300 000 0000"
                android:textColor="#3F3F3A"
                android:textColorHint="#999991"
                android:textSize="15sp"/>


            <!-- ================================= -->
            <!-- SECCIÓN: CAMBIAR CONTRASEÑA -->
            <!-- ================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nueva contraseña"
                android:textColor="#3F3F3A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPasswordNueva"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Ingresa la nueva contraseña"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#3F3F3A"
                android:textColorHint="#999991"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Confirmar nueva contraseña"
                android:textColor="#3F3F3A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPasswordConfirmar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_input"
                android:hint="Repite la nueva contraseña"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:singleLine="true"
                android:textColor="#3F3F3A"
                android:textColorHint="#999991"
                android:textSize="15sp"/>


            <!-- ================================= -->
            <!-- BOTÓN GUARDAR -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/btnGuardarCambios"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_manana_activo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Actualizar contraseña"
                android:textColor="#493C0B"
                android:textSize="16sp"
                android:textStyle="bold"/>


            <!-- ================================= -->
            <!-- CANCELAR -->
            <!-- ================================= -->

            <TextView
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_boton_contorno"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Cancelar"
                android:textColor="#477A26"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>


    <!-- ========================================= -->
    <!-- BARRA -->
    <!-- ========================================= -->

    <include
        android:id="@+id/barraNavegacion"
        layout="@layout/activity_barra_navegacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>