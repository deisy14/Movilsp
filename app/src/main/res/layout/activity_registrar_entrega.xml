<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/blanco"

    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">

        <!-- ================================================= -->
        <!-- TITULO                                            -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnCerrar"

                android:layout_width="44dp"
                android:layout_height="44dp"

                android:background="@drawable/bg_icono_circular"

                android:padding="10dp"

                android:src="@drawable/ic_arrow_back"

                android:tint="@color/negro_principal"

                android:contentDescription="Volver"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="12dp"

                android:text="Registrar entrega"

                android:textColor="@color/negro_principal"

                android:textSize="22sp"

                android:textStyle="bold"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- JORNADA                                           -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtJornada"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Jornada: Mañana"

            android:textColor="@color/gris_texto"

            android:textSize="13sp"/>

        <!-- ================================================= -->
        <!-- INFORMACIÓN                                       -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Registra los alimentos entregados por el supervisor y la cantidad recibida."

            android:textColor="@color/gris_texto"

            android:textSize="13sp"/>

        <!-- ================================================= -->
        <!-- ARROZ                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginTop="20dp"

            android:gravity="center_vertical"

            android:padding="12dp"

            android:background="@drawable/bg_card_resumen">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:padding="8dp"

                android:background="@drawable/bg_icono_verde"

                android:src="@drawable/ic_food"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="12dp"

                android:text="Arroz"

                android:textColor="@color/negro_principal"

                android:textSize="15sp"

                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtArroz"

                android:layout_width="90dp"
                android:layout_height="48dp"

                android:hint="0"

                android:inputType="numberDecimal"

                android:gravity="center"

                android:textSize="14sp"

                android:background="@drawable/bg_campo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="5dp"

                android:text="kg"

                android:textColor="@color/gris_texto"

                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- POLLO                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginTop="10dp"

            android:gravity="center_vertical"

            android:padding="12dp"

            android:background="@drawable/bg_card_resumen">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:padding="8dp"

                android:background="@drawable/bg_icono_amarillo"

                android:src="@drawable/ic_food"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="12dp"

                android:text="Pollo"

                android:textColor="@color/negro_principal"

                android:textSize="15sp"

                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPollo"

                android:layout_width="90dp"
                android:layout_height="48dp"

                android:hint="0"

                android:inputType="numberDecimal"

                android:gravity="center"

                android:background="@drawable/bg_campo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="5dp"

                android:text="kg"

                android:textColor="@color/gris_texto"

                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- LENTEJAS                                          -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginTop="10dp"

            android:gravity="center_vertical"

            android:padding="12dp"

            android:background="@drawable/bg_card_resumen">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:padding="8dp"

                android:background="@drawable/bg_icono_verde"

                android:src="@drawable/ic_food"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="12dp"

                android:text="Lentejas"

                android:textColor="@color/negro_principal"

                android:textSize="15sp"

                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtLentejas"

                android:layout_width="90dp"
                android:layout_height="48dp"

                android:hint="0"

                android:inputType="numberDecimal"

                android:gravity="center"

                android:background="@drawable/bg_campo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="5dp"

                android:text="kg"

                android:textColor="@color/gris_texto"

                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- PASTA                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginTop="10dp"

            android:gravity="center_vertical"

            android:padding="12dp"

            android:background="@drawable/bg_card_resumen">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:padding="8dp"

                android:background="@drawable/bg_icono_amarillo"

                android:src="@drawable/ic_food"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="12dp"

                android:text="Pasta"

                android:textColor="@color/negro_principal"

                android:textSize="15sp"

                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtPasta"

                android:layout_width="90dp"
                android:layout_height="48dp"

                android:hint="0"

                android:inputType="numberDecimal"

                android:gravity="center"

                android:background="@drawable/bg_campo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="5dp"

                android:text="kg"

                android:textColor="@color/gris_texto"

                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- VERDURAS                                          -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"

            android:layout_marginTop="10dp"

            android:gravity="center_vertical"

            android:padding="12dp"

            android:background="@drawable/bg_card_resumen">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"

                android:padding="8dp"

                android:background="@drawable/bg_icono_verde"

                android:src="@drawable/ic_food"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:layout_marginStart="12dp"

                android:text="Verduras"

                android:textColor="@color/negro_principal"

                android:textSize="15sp"

                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtVerduras"

                android:layout_width="90dp"
                android:layout_height="48dp"

                android:hint="0"

                android:inputType="numberDecimal"

                android:gravity="center"

                android:background="@drawable/bg_campo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="5dp"

                android:text="kg"

                android:textColor="@color/gris_texto"

                android:textSize="12sp"/>

        </LinearLayout>

        <!-- ================================================= -->
        <!-- GUARDAR                                            -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Guardar entrega"
            android:textColor="@color/blanco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/amarillo_principal"/>

        <Button
            android:id="@+id/btnCancelar"

            android:layout_width="match_parent"
            android:layout_height="48dp"

            android:layout_marginTop="8dp"

            android:text="Cancelar"

            android:textColor="@color/negro_principal"

            android:backgroundTint="@color/gris_claro"/>

    </LinearLayout>

</ScrollView>