<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Volver"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1B3317" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloProgramacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programación Semanal PAE"
                    android:textColor="#1B3317"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtituloProgramacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Organiza los platos de lunes a viernes"
                    android:textColor="#3D5C37"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- SELECTOR DE SEMANA ACTUAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_tag_plato"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnSemanaAnterior"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Semana anterior"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1B3317" />

            <TextView
                android:id="@+id/txtSemanaActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Semana del 5 al 9 de Octubre"
                android:textColor="#1B3317"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSemanaSiguiente"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Semana siguiente"
                android:padding="8dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1B3317" />

        </LinearLayout>

        <!-- INFO -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Programa con Anticipación"
                    android:textColor="#1B3317"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtInfoProgramacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Define el plato de cada jornada escolar de lunes a viernes."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- LUNES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLunes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtLunes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lunes"
                    android:textColor="#1B3317"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFechaLunes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="5 de Octubre"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <!-- MAÑANA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Mañana"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoLunesManana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarLunesManana"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

                <!-- TARDE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Tarde"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoLunesTarde"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarLunesTarde"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MARTES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMartes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtMartes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Martes"
                    android:textColor="#1B3317"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFechaMartes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="6 de Octubre"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Mañana"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoMartesManana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarMartesManana"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Tarde"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoMartesTarde"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarMartesTarde"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MIÉRCOLES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMiercoles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtMiercoles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Miércoles"
                    android:textColor="#1B3317"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFechaMiercoles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="7 de Octubre"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Mañana"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoMiercolesManana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarMiercolesManana"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Tarde"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoMiercolesTarde"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarMiercolesTarde"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- JUEVES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJueves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtJueves"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jueves"
                    android:textColor="#1B3317"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFechaJueves"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="8 de Octubre"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Mañana"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoJuevesManana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarJuevesManana"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Tarde"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoJuevesTarde"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarJuevesTarde"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- VIERNES -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViernes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtViernes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Viernes"
                    android:textColor="#1B3317"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFechaViernes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="9 de Octubre"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Mañana"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoViernesManana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarViernesManana"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="Tarde"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPlatoViernesTarde"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sin plato programado"
                        android:textColor="#1B3317"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnEditarViernesTarde"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:contentDescription="Editar"
                        android:padding="9dp"
                        android:src="@drawable/ic_editar"
                        app:tint="#1B3317" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- BOTONES FINALES -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarProgramacion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#F4B41F"
            android:text="Guardar Programación"
            android:textColor="#1B3317"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:textColor="#1B3317"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:strokeColor="#C5DFC3" />

    </LinearLayout>

</ScrollView>