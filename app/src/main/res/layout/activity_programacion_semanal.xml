                <ImageButton
                    android:id="@+id/btnEditarDomingoManana"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icono_circular"
                    android:contentDescription="Editar plato del domingo en la mañana"
                    android:padding="9dp"
                    android:src="@drawable/ic_editar"
                    android:tint="@color/negro_principal" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Tarde"
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPlatoDomingoTarde"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sin plato programado"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnEditarDomingoTarde"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icono_circular"
                    android:contentDescription="Editar plato del domingo en la tarde"
                    android:padding="9dp"
                    android:src="@drawable/ic_editar"
                    android:tint="@color/negro_principal" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- GUARDAR                                            -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnGuardarProgramacion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/amarillo_principal"
            android:text="Guardar programación"
            android:textColor="@color/blanco"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/gris_claro"
            android:text="Cancelar"
            android:textColor="@color/negro_principal"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>