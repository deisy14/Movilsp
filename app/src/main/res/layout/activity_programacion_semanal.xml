            android:background="@drawable/bg_card_resumen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtLunes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lunes"
                android:textColor="@color/negro_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaLunes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="28 de septiembre"
                android:textColor="@color/gris_texto"
                android:textSize="12sp" />

            <!-- MAÑANA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Mañana"
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPlatoLunesManana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sin plato programado"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnEditarLunesManana"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icono_circular"
                    android:contentDescription="Editar plato del lunes en la mañana"
                    android:padding="9dp"
                    android:src="@drawable/ic_editar"
                    android:tint="@color/negro_principal" />

            </LinearLayout>

            <!-- TARDE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:text="Tarde"
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPlatoLunesTarde"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sin plato programado"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnEditarLunesTarde"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_icono_circular"
                    android:contentDescription="Editar plato del lunes en la tarde"
                    android:padding="9dp"
                    android:src="@drawable/ic_editar"
                    android:tint="@color/negro_principal" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
