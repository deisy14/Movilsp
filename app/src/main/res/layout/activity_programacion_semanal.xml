<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!-- ENCABEZADO                                        -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_circular"
                android:contentDescription="Volver"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/negro_principal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloProgramacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programación semanal"
                    android:textColor="@color/negro_principal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtituloProgramacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Organiza los platos de toda la semana"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SEMANA                                             -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnSemanaAnterior"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icono_circular"
                android:contentDescription="Semana anterior"
                android:padding="9dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/negro_principal" />

            <TextView
                android:id="@+id/txtSemanaActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Semana del 28 de septiembre"
                android:textColor="@color/negro_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSemanaSiguiente"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icono_circular"
                android:contentDescription="Semana siguiente"
                android:padding="9dp"
                android:rotation="180"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/negro_principal" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- INFORMACIÓN                                        -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_resumen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Programa con anticipación"
                android:textColor="@color/negro_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInfoProgramacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Puedes definir el plato de cada jornada para evitar tener que programarlo diariamente."
                android:textColor="@color/gris_texto"
                android:textSize="12sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- LUNES                                              -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/cardLunes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
