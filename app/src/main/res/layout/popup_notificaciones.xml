<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/popupNotificaciones"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_notificaciones"
    android:elevation="12dp"
    android:padding="16dp">

    <!-- ================================================= -->
    <!-- ENCABEZADO                                        -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtTituloNotificaciones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notificaciones"
            android:textColor="@color/negro_principal"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtCantidadNotificaciones"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/blanco"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_notificacion"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- SEPARADOR                                         -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/gris_claro"/>


    <!-- ================================================= -->
    <!-- CONTENEDOR DE NOTIFICACIONES                     -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/contenedorNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">


        <!-- ============================================= -->
        <!-- NOTIFICACIÓN: PREPARACIÓN                     -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/notificacionPreparacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iconoPreparacion"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/bg_icono_amarillo"
                android:src="@drawable/ic_nav_preparaciones"
                android:tint="@color/negro_principal"
                android:contentDescription="Preparación"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloPreparacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preparación pendiente"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtMensajePreparacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hay una preparación pendiente."
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- NOTIFICACIÓN: INVENTARIO                      -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/notificacionInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iconoInventario"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/bg_icono_verde"
                android:src="@drawable/ic_nav_inventario"
                android:tint="@color/negro_principal"
                android:contentDescription="Inventario"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloInventario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inventario actualizado"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtMensajeInventario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Se registró una nueva entrega."
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- NOTIFICACIÓN: ASISTENCIA                      -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/notificacionAsistencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iconoAsistencia"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:padding="9dp"
                android:background="@drawable/bg_icono_amarillo"
                android:src="@drawable/ic_nav_manipuladoras"
                android:tint="@color/negro_principal"
                android:contentDescription="Asistencia"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloAsistencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Asistencia pendiente"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtMensajeAsistencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Recuerda registrar la asistencia."
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- SIN NOTIFICACIONES                                -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/contenedorSinNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_notificaciones"
            android:tint="@color/gris_texto"
            android:contentDescription="Sin notificaciones"/>

        <TextView
            android:id="@+id/txtSinNotificaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No tienes nuevas notificaciones"
            android:textColor="@color/gris_texto"
            android:textSize="13sp"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- VER TODAS                                         -->
    <!-- ================================================= -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/gris_claro"/>

    <TextView
        android:id="@+id/btnVerTodasNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="Ver todas"
        android:textColor="@color/amarillo_principal"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>