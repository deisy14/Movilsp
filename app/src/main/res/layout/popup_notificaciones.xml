<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/popupNotificaciones"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtTituloNotificaciones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notificaciones"
                android:textColor="#1B3317"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCantidadNotificaciones"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_badge_notificacion"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E2E8F0" />

        <!-- CONTENEDOR DE NOTIFICACIONES -->
        <LinearLayout
            android:id="@+id/contenedorNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <!-- NOTIFICACIÓN: PREPARACIÓN -->
            <LinearLayout
                android:id="@+id/notificacionPreparacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/iconoPreparacion"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_yellow"
                    android:contentDescription="Preparación"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_preparations"
                    app:tint="#1B3317" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloPreparacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Preparación pendiente"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMensajePreparacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hay una preparación pendiente."
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- NOTIFICACIÓN: INVENTARIO -->
            <LinearLayout
                android:id="@+id/notificacionInventario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/iconoInventario"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_green"
                    android:contentDescription="Inventario"
                    android:padding="9dp"
                    android:src="@drawable/ic_nav_inventory"
                    app:tint="#2A5226" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloInventario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Inventario actualizado"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMensajeInventario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Se registró una nueva entrega."
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- NOTIFICACIÓN: ASISTENCIA -->
            <LinearLayout
                android:id="@+id/notificacionAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/iconoAsistencia"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_yellow"
                    android:contentDescription="Asistencia"
                    android:padding="9dp"
                    android:src="@drawable/ic_people"
                    app:tint="#1B3317" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloAsistencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Asistencia pendiente"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtMensajeAsistencia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Recuerda registrar la asistencia."
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- SIN NOTIFICACIONES -->
        <LinearLayout
            android:id="@+id/contenedorSinNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Sin notificaciones"
                android:src="@drawable/ic_notificaciones"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/txtSinNotificaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No tienes nuevas notificaciones"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/btnVerTodasNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Ver todas"
            android:textColor="#7A5500"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>