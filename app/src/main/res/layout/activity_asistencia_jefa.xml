<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutAsistencia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F5"
    android:orientation="vertical"
    tools:context=".ui.manipuladora_Jefe.AsistenciaJefaActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">

            <!-- ENCABEZADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Volver"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#1B3317" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asistencia por Grados"
                        android:textColor="#1B3317"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFechaAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hoy es lunes, 29 de septiembre"
                        android:textColor="#3D5C37"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- DESCRIPCIÓN PAE GRAMAJE -->
            <TextView
                android:id="@+id/txtDescripcionAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Registra la asistencia separada por grados (Primaria vs. Secundaria) para calcular el gramaje y racionar la cocción exacta."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- JORNADA -->
            <TextView
                android:id="@+id/txtTituloJornada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Selecciona la jornada"
                android:textColor="#1B3317"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorJornadas"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManana"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F4B41F"
                    android:text="Mañana"
                    android:textColor="#1B3317"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTarde"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Tarde"
                    android:textColor="#1B3317"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#C5DFC3" />

            </LinearLayout>

            <!-- TARJETA DE ASISTENCIA Y GRAMAJE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_pill_yellow"
                            android:contentDescription="Asistencia"
                            android:padding="10dp"
                            android:src="@drawable/ic_people"
                            app:tint="#1B3317" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtTituloCantidad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL ASISTENCIA REGISTRADA"
                                android:textColor="#7A5500"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtCantidadAsistencia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0 estudiantes"
                                android:textColor="#1B3317"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- DESGROSE POR GRADO (PRIMARIA VS SECUNDARIA) -->
                    <TextView
                        android:id="@+id/txtDesglosePrimariaSecundaria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tag_plato"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Primaria (1°-5°): 0 | Secundaria (6°-11°): 0"
                        android:textColor="#1B3317"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- RESULTADO CÁLCULO TOTAL GRAMAJE -->
                    <TextView
                        android:id="@+id/txtGramajeTotalCalculado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_pill_yellow"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Requerimiento Total Gramaje: 0.0 kg"
                        android:textColor="#7A5500"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- JORNADA ACTUAL Y ESTADO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtJornadaActual"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Jornada: Mañana"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtEstadoAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_green"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="Pendiente"
                            android:textColor="#2A5226"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- BOTÓN REGISTRAR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegistrarAsistencia"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#F4B41F"
                        android:text="Registrar asistencia por grados"
                        android:textColor="#1B3317"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- INFORMACIÓN IA Y PAE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/infoIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#E2EFE0"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#C5DFC3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="13dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Información"
                        android:src="@drawable/ic_info"
                        app:tint="#1B3317" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="El gramaje PAE se diferencia automáticamente según los requerimientos nutricionales de primaria vs. secundaria."
                        android:textColor="#1B3317"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>