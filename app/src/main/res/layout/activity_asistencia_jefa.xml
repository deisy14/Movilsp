<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/layoutAsistencia"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="@color/blanco"

    tools:context=".AsistenciaJefaActivity">


    <!-- ===================================================== -->
    <!-- CONTENIDO                                             -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <ImageButton
                    android:id="@+id/btnVolver"
                    android:layout_width="44dp"
                    android:layout_height="44dp"

                    android:background="@android:color/transparent"
                    android:contentDescription="Volver"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/negro_principal"/>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:orientation="vertical"

                    android:paddingStart="8dp">


                    <TextView
                        android:id="@+id/txtTituloAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Asistencia"
                        android:textColor="@color/negro_principal"
                        android:textSize="22sp"
                        android:textStyle="bold"/>


                    <TextView
                        android:id="@+id/txtFechaAsistencia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"

                        android:text="Hoy es lunes, 29 de septiembre"
                        android:textColor="@color/gris_texto"
                        android:textSize="13sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- DESCRIPCIÓN                                      -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtDescripcionAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:text="Registra la cantidad de niños que asistirán para que la IA pueda generar sugerencias de platos."
                android:textColor="@color/gris_texto"
                android:textSize="14sp"/>


            <!-- ================================================= -->
            <!-- JORNADA                                           -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTituloJornada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="26dp"

                android:text="Selecciona la jornada"
                android:textColor="@color/negro_principal"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <LinearLayout
                android:id="@+id/contenedorJornadas"
                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginTop="10dp"

                android:orientation="horizontal">


                <!-- MAÑANA -->

                <Button
                    android:id="@+id/btnManana"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:text="Mañana"
                    android:textColor="@color/blanco"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    android:backgroundTint="@color/amarillo_principal"/>


                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>


                <!-- TARDE -->

                <Button
                    android:id="@+id/btnTarde"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"

                    android:layout_weight="1"

                    android:text="Tarde"
                    android:textColor="@color/negro_principal"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    android:backgroundTint="@color/gris_claro"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- TARJETA DE ASISTENCIA                             -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardAsistencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="24dp"

                android:background="@drawable/bg_card_resumen"

                android:orientation="vertical"

                android:padding="18dp">


                <!-- ENCABEZADO TARJETA -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"

                        android:background="@drawable/bg_icono_amarillo"

                        android:contentDescription="Asistencia"
                        android:padding="10dp"
                        android:src="@drawable/ic_people"/>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="12dp"

                        android:layout_weight="1"

                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/txtTituloCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Niños registrados"
                            android:textColor="@color/gris_texto"
                            android:textSize="12sp"/>


                        <TextView
                            android:id="@+id/txtCantidadAsistencia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="3dp"

                            android:text="0 niños"
                            android:textColor="@color/negro_principal"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- JORNADA ACTUAL -->

                <TextView
                    android:id="@+id/txtJornadaActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="16dp"

                    android:text="Jornada: Mañana"
                    android:textColor="@color/gris_texto"
                    android:textSize="13sp"/>


                <!-- ESTADO -->

                <TextView
                    android:id="@+id/txtEstadoAsistencia"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:background="@drawable/bg_estado"

                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"

                    android:text="Pendiente"
                    android:textColor="@color/rojo_principal"
                    android:textSize="11sp"
                    android:textStyle="bold"/>


                <!-- BOTÓN -->

                <Button
                    android:id="@+id/btnRegistrarAsistencia"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"

                    android:layout_marginTop="16dp"

                    android:text="Registrar asistencia"
                    android:textColor="@color/blanco"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    android:backgroundTint="@color/amarillo_principal"/>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INFORMACIÓN IA                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/infoIA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:background="@drawable/bg_info"

                android:gravity="center_vertical"

                android:orientation="horizontal"

                android:padding="13dp">


                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"

                    android:contentDescription="Información"
                    android:padding="6dp"
                    android:src="@drawable/ic_info"/>


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="9dp"

                    android:layout_weight="1"

                    android:text="La asistencia registrada será utilizada junto con el inventario disponible para generar las sugerencias de la IA."
                    android:textColor="@color/gris_texto"
                    android:textSize="12sp"/>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>