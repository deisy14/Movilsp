<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/barraNavegacionJefaContainer"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingHorizontal="12dp"
    android:paddingBottom="24dp"
    android:background="@android:color/transparent">

    <!-- Background with Notch -->
    <com.example.movilmanupuladora.ui.manipuladora.BottomBarBackground
        android:id="@+id/bottomBarBg"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom" />

    <!-- Navigation Items Layout -->
    <LinearLayout
        android:id="@+id/barraNavegacionJefa"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- 1. Inicio -->
        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavInicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_nav_home"
                app:tint="#000000" />

            <TextView
                android:id="@+id/txtNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Inicio"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 2. Inventario -->
        <LinearLayout
            android:id="@+id/navInventario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavInventario"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Inventario"
                android:src="@drawable/ic_nav_inventory"
                app:tint="#000000" />

            <TextView
                android:id="@+id/txtNavInventario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Inventario"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 3. Center Spacer for FAB -->
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- 4. Preparaciones -->
        <LinearLayout
            android:id="@+id/navPreparaciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavPreparaciones"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Preparaciones"
                android:src="@drawable/ic_nav_preparations"
                app:tint="#000000" />

            <TextView
                android:id="@+id/txtNavPreparaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Preparaciones"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 5. Equipo / Manipuladoras -->
        <LinearLayout
            android:id="@+id/navManipuladoras"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavManipuladoras"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Equipo"
                android:src="@drawable/ic_nav_team"
                app:tint="#000000" />

            <TextView
                android:id="@+id/txtNavManipuladoras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Equipo"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Center Add Button (+) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/fabAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@null"
        app:cardBackgroundColor="#F4B41F"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:cardMaxElevation="2dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="Agregar"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/negro" />
    </androidx.cardview.widget.CardView>

</FrameLayout>