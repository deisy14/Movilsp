<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/barraNavegacionJefaCard"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/barraNavegacionJefa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5"
            android:paddingHorizontal="6dp">

            <!-- INICIO -->
            <LinearLayout
                android:id="@+id/navInicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconNavInicio"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inicio"
                    android:src="@drawable/ic_nav_inicio" />

                <TextView
                    android:id="@+id/txtNavInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Inicio"
                    android:textColor="#1B3317"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- INVENTARIO -->
            <LinearLayout
                android:id="@+id/navInventario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconNavInventario"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Inventario"
                    android:src="@drawable/ic_nav_inventario" />

                <TextView
                    android:id="@+id/txtNavInventario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Inventario"
                    android:textColor="#667085"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- PREPARACIONES -->
            <LinearLayout
                android:id="@+id/navPreparaciones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconNavPreparaciones"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Preparaciones"
                    android:src="@drawable/ic_nav_preparaciones" />

                <TextView
                    android:id="@+id/txtNavPreparaciones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Preparaciones"
                    android:textColor="#667085"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- MANIPULADORAS -->
            <LinearLayout
                android:id="@+id/navManipuladoras"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconNavManipuladoras"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Manipuladoras"
                    android:src="@drawable/ic_nav_manipuladoras" />

                <TextView
                    android:id="@+id/txtNavManipuladoras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Equipo"
                    android:textColor="#667085"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- PERFIL -->
            <LinearLayout
                android:id="@+id/navPerfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iconNavPerfil"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_nav_perfil" />

                <TextView
                    android:id="@+id/txtNavPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Perfil"
                    android:textColor="#667085"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>