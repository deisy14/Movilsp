<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:strokeColor="#F4B41F"
    app:strokeWidth="1.5dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtTituloConfirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Confirmar Asignación de Componentes"
                android:textColor="#1B3317"
                android:textSize="19sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="14dp"
                android:background="#E2E8F0" />

            <TextView
                android:id="@+id/txtMensajeConfirmacionAsignacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plato y distribución..."
                android:textColor="#334155"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarGuardarAsignacion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#F4B41F"
                android:text="Confirmar y Guardar"
                android:textAllCaps="false"
                android:textColor="#1B3317"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeguirEditandoAsignacion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="Seguir editando"
                android:textAllCaps="false"
                android:textColor="#64748B"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>