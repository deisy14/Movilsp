<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">

        <shape>

            <solid android:color="@color/verde_muy_claro"/>

            <stroke
                android:width="2dp"
                android:color="@color/verde_principal"/>

            <corners android:radius="15dp"/>

        </shape>

    </item>

    <item>

        <shape>

            <solid android:color="@color/gris_fondo"/>

            <stroke
                android:width="1dp"
                android:color="@color/gris_borde"/>

            <corners android:radius="15dp"/>

        </shape>

    </item>

</selector>