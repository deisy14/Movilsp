<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo -->
    <solid android:color="#FAFAF7"/>

    <!-- Bordes redondeados -->
    <corners android:radius="14dp"/>

    <!-- Borde rojo -->
    <stroke
        android:width="1dp"
        android:color="#B3261E"/>

    <!-- Espaciado interno -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp"/>

</shape>
